# 环境变量示例 —— 复制为 .env 或 .env.local 后填写（这两个文件都被 .gitignore 忽略，不该提交）
#
# 通道说明：PUBLIC_ 前缀的变量由 Vite 在构建时内联成 import.meta.env.XXX（会出现在前端产物里）；
# 不带前缀的只在不带 PUBLIC_ 的地方读（如构建期插件读 process.env），不会进前端产物。
# 优先级：进程环境变量（部署平台里配）> .env / .env.local 文件 > src/config/*.ts 里的兜底值。
# 仓库里这些值一律留空 —— 开源后不把密钥写进配置文件。

# ── 私有内容仓库（dev 与 build 前会用到，必配）──────────────────────────
# 博客内容（文章 / 动态 / 足迹 / 项目 / about）放在私有仓库 my-blog-content 里，
# dev 与 build 的第一步会执行 node scripts/sync-content.mjs 把它拉到 src/content。
# 私有仓库需要凭据，否则拉取失败；本地没有内容时会**中止构建**（避免部署出空站）。
# token：GitHub 细粒度 PAT，权限只需 Contents: Read-only。
#   本地如果 git 已经记住凭据（凭据管理器 / SSH），这里可以留空。
CONTENT_REPO_URL=https://github.com/ImYufish/my-blog-content.git
CONTENT_REPO_TOKEN=
CONTENT_REPO_BRANCH=main

# ── 足迹地图（/places/）──────────────────────────────────────────────
# 高德开放平台「Web端 (JS API)」key（读取处：src/pages/places.astro → config/placesConfig.ts 兜底）
# 申请：https://console.amap.com/dev/key/app → 新建应用 → 添加 Key → 服务平台选「Web端(JS API)」
# 注意：这是前端可见的 key，务必在控制台把「域名白名单」限制为你的站点域名。
# 留空时地图区域空白，其余内容照常显示。改完需重启 dev server / 重新构建。
PUBLIC_AMAP_KEY_PLACES=

# ── 天气组件（侧栏）─────────────────────────────────────────────────
# 和风天气（QWeather）API Key（读取处：src/components/widget/Weather.astro）
# 申请：https://console.qweather.com/ → 项目 → 创建凭据（API Key）→ 记下该项目的 API Host，
#       把 host 填到 src/config/weatherConfig.ts 的 qweatherHost / qweatherGeoHost。
# ⚠ 这也是前端可见的 key，且和风没有域名白名单 —— 泄露会被盗刷配额；不要提交到仓库。
# 留空则天气组件自动跳过和风源，改用免 Key 的 uapis / Open-Meteo / wttr。
PUBLIC_QWEATHER_KEY=

# ── 头条/字节 自动收录（全站注入 push.js）─────────────────────────────
# 字节站长平台的「自动收录」脚本查询参数（即 push.js?<token> 那段）
# 获取：字节跳动站长平台 → 站点设置 → 自动收录 → 复制脚本里的 token
# 读取处：src/layouts/Layout.astro（构建期内联；该值本来就会出现在页面 HTML 里，属「半公开」）
# 留空则不注入脚本。需配合 public/ByteDanceVerify.html 完成站点所有权验证。
PUBLIC_TOUTIAO_TOKEN=

# ── 百度主动推送（构建期提交 URL，不留前端）──────────────────────────
# 百度搜索资源平台 → 数据提交 → API 推送 的 16 位 token
# 读取处：src/plugins/indexNow.mjs（astro:build:done 时读 process.env，只在构建期用）
# 留空则构建日志提示未配置并跳过百度推送。⚠ 这是唯一「只藏在构建环境里」的真密钥，不要提交。
BAIDU_PUSH_TOKEN=

# ── MyAnimeList 追番页（/myanimelist/）────────────────────────────────
# MAL Client ID：https://myanimelist.net/apiconfig → 创建应用后获取（public client，可前端调用）
# 读取处：src/pages/myanimelist.astro（兜底 config/siteConfig.ts 的 mal.clientId）
# 留空则该页面不请求数据。同时把 config/siteConfig.ts 的 mal.username 改成你的 MAL 用户名。
PUBLIC_MAL_CLIENT_ID=

# ── 其它（本项目自建服务，按需）──────────────────────────────────────
# GitHub 细粒度 token（Contents: Read），给 /api/github-pushes.json 在构建期读提交历史用；
# 站点统计页「推送节奏」卡片依赖它。未配则回退本地 git log。
GITHUB_PUSHES_TOKEN=
