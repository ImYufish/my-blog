---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface WidgetConfig {
	showTitle?: boolean;
	[key: string]: unknown;
}

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetConfig;
}
const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const widgetId = "hitokoto-widget";
---

<WidgetLayout
  id={widgetId}
  name={i18n(I18nKey.hitokoto)}
  showTitle={showTitle}
  class={className}
  style={style}
>
  <div class="hitokoto-widget flex flex-col gap-2" data-widget>
    <div class="hitokoto-body flex flex-col gap-1.5">
      <blockquote class="hitokoto-text text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
        <span class="hitokoto-mark select-none">"</span><span class="hitokoto-content"></span><span class="hitokoto-mark select-none">"</span>
      </blockquote>
      <div class="hitokoto-foot flex flex-col gap-1">
        <span class="hitokoto-source text-xs italic text-neutral-400 dark:text-neutral-500 break-all"></span>
        <button
          type="button"
          class="hitokoto-refresh self-end inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs text-neutral-500 transition-colors hover:bg-neutral-200/60 dark:text-neutral-400 dark:hover:bg-neutral-700/60"
          aria-label="换一句"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          换一句
        </button>
      </div>
    </div>
  </div>
</WidgetLayout>

<style>
  .hitokoto-mark {
    color: var(--color-neutral-400, #a3a3a3);
  }
  .hitokoto-text {
    min-height: 2.5rem;
    word-break: break-word;
    border-left: 3px solid var(--color-neutral-200, #e5e5e5);
    padding-left: 0.75rem;
  }
</style>

<script>
  import { getRandomHitokoto, formatHitokoto } from "@/utils/hitokoto";
  import { hitokotoConfig, HITOKOTO_CAT_NAMES } from "@/config/hitokotoConfig";

  // 拉一条随机一言并填进组件：正文 + 出处行（分类 / 出处 / 作者按配置中心开关拼）
  // 取数走共享模块，侧边栏和横幅共用同一份内存池，不会重复拉取
  function fillOne(el: HTMLElement) {
    const contentEl = el.querySelector<HTMLElement>(".hitokoto-content");
    const srcEl = el.querySelector<HTMLElement>(".hitokoto-source");
    if (!contentEl || !srcEl) return Promise.resolve();
    return getRandomHitokoto({
      bundleSource: hitokotoConfig.bundleSource,
      remoteUrl: hitokotoConfig.remoteUrl,
      fallbackToLocal: hitokotoConfig.fallbackToLocal,
      enableCategories: hitokotoConfig.enableCategories,
      minLength: hitokotoConfig.minLength,
      maxLength: hitokotoConfig.maxLength,
    }).then((item) => {
      contentEl.textContent = item.hitokoto || "";
      const s = formatHitokoto(item, {
        showSource: hitokotoConfig.showSource,
        showAuthor: hitokotoConfig.showAuthor,
        showCategory: hitokotoConfig.showCategory,
        catNames: HITOKOTO_CAT_NAMES,
      });
      srcEl.textContent = s;
      // 啥都不显示就把出处行藏起来，免得留个空行
      srcEl.style.display = s ? "" : "none";
    });
  }

  function initHitokoto(root: ParentNode) {
    const el = root.querySelector<HTMLElement>(".hitokoto-widget");
    if (!el || el.dataset.bound === "1") return;
    el.dataset.bound = "1";
    const btn = el.querySelector<HTMLElement>(".hitokoto-refresh");
    if (btn) btn.addEventListener("click", () => fillOne(el).catch(() => {}));
    fillOne(el).catch((e) => {
      console.warn("[hitokoto] 加载失败：", e);
      // 走到这里就是所有数据源都拿不到（本地包缺失 / 远程挂且回退本地也挂），
      // 直接隐藏整个组件（含标题），不显示错误文案
      const layout = el.closest<HTMLElement>("widget-layout");
      if (layout) layout.style.display = "none";
    });
  }

  // Swup 页面过渡会替换 DOM 但不重载脚本，靠这个事件重新绑定到新节点
  document.addEventListener("astro:page-load", () => initHitokoto(document));
  // 首屏直接跑一次（和上面事件初次可能都触发，dataset.bound 保证只绑一次）
  initHitokoto(document);
</script>