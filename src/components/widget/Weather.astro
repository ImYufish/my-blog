---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { weatherConfig } from "@/config/weatherConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface WidgetConfig {
	showTitle?: boolean;
	[key: string]: unknown;
}

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetConfig;
}
const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const widgetId = "weather-widget";
const cfg = JSON.stringify({
	defaultCity: weatherConfig.defaultCity,
	defaultLat: weatherConfig.defaultLat,
	defaultLon: weatherConfig.defaultLon,
	autoLocate: weatherConfig.autoLocate,
	unit: weatherConfig.unit ?? "celsius",
	qweatherKey: weatherConfig.qweatherKey,
	qweatherHost: weatherConfig.qweatherHost,
	qweatherGeoHost: weatherConfig.qweatherGeoHost,
	enableUapis: weatherConfig.enableUapis,
	enableQWeather: weatherConfig.enableQWeather,
	enableOpenMeteo: weatherConfig.enableOpenMeteo,
	enableWttr: weatherConfig.enableWttr,
});

// 天气图标：用 material-symbols 替代原来的 emoji（该图标集是站点主导图标集，全站已加载，
// 圆润实心、在 2rem/0.8rem 两个尺寸下都清晰）。
// 天气数据是客户端 fetch 的，单个 <Icon> 没法运行时换名字，所以这里预渲染全部条件图标，
// 客户端 render() 只切换 .weather-icon 的 data-cond，由 CSS 决定显示哪一个。
// 多云 / 阴 用实心与线框区分；日出日落用 wb-twilight / wb-twilight-2。
const WEATHER_ICONS = [
	{ cond: "sunny", icon: "material-symbols:sunny" },
	{ cond: "night", icon: "material-symbols:dark-mode" },
	{ cond: "partly", icon: "material-symbols:partly-cloudy-day" },
	{ cond: "cloudy", icon: "material-symbols:cloud-outline" },
	{ cond: "overcast", icon: "material-symbols:cloud" },
	{ cond: "fog", icon: "material-symbols:foggy" },
	{ cond: "drizzle", icon: "material-symbols:rainy-light" },
	{ cond: "rain", icon: "material-symbols:rainy" },
	{ cond: "sleet", icon: "material-symbols:rainy-snow" },
	{ cond: "snow", icon: "material-symbols:weather-snowy" },
	{ cond: "snow-heavy", icon: "material-symbols:snowing-heavy" },
	{ cond: "thunder", icon: "material-symbols:thunderstorm" },
	{ cond: "hot", icon: "material-symbols:thermostat-arrow-up" },
	{ cond: "cold", icon: "material-symbols:thermostat-arrow-down" },
	{ cond: "unknown", icon: "material-symbols:question-mark" },
];
---

<WidgetLayout
  id={widgetId}
  name={i18n(I18nKey.weather)}
  showTitle={showTitle}
  class={className}
  style={style}
>
  <div class="weather-widget flex flex-col" data-widget>
    <!-- 收起态：图标 + 温度(含高低) + 城市(到区) | 天气描述 | 箭头 -->
    <div class="weather-header flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="weather-icon" data-cond="partly" aria-hidden="true">
          {WEATHER_ICONS.map((w) => (
            <span class="w-ic" data-ic={w.cond}><Icon name={w.icon} /></span>
          ))}
        </span>
        <div class="flex flex-col">
          <div class="flex items-baseline gap-2">
            <span class="weather-temp text-2xl font-bold text-neutral-900 dark:text-neutral-100 leading-none">--°</span>
            <span class="weather-temp-range text-xs text-neutral-400 dark:text-neutral-500"></span>
          </div>
          <span class="weather-city text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">定位中…</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="weather-desc text-sm text-neutral-600 dark:text-neutral-300"></span>
        <button
          type="button"
          class="weather-toggle inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs text-neutral-500 transition-colors hover:bg-neutral-200/60 dark:text-neutral-400 dark:hover:bg-neutral-700/60"
          aria-label="展开天气详情"
          aria-expanded="false"
        >
          <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- 展开详情区 -->
    <div class="weather-details">
      <div class="weather-grid">
        <!-- 风力 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-wind"><Icon name="material-symbols:air" /></span><span class="detail-label">风力</span></div><span class="detail-val weather-wind-detail"></span></div>
        <!-- 能见度 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-vis"><Icon name="material-symbols:visibility" /></span><span class="detail-label">能见度</span></div><span class="detail-val weather-vis"></span></div>
        <!-- 体感温度 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-feel"><Icon name="material-symbols:device-thermostat" /></span><span class="detail-label">体感温度</span></div><span class="detail-val weather-feel"></span></div>
        <!-- 湿度 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-humidity"><Icon name="material-symbols:water-drop" /></span><span class="detail-label">湿度</span></div><span class="detail-val weather-humidity"></span></div>
        <!-- 气压 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-pressure"><Icon name="material-symbols:speed" /></span><span class="detail-label">气压</span></div><span class="detail-val weather-pressure"></span></div>
        <!-- 空气质量（大数字 + 彩色标签） -->
        <div class="detail-card detail-aqi-card"><div class="detail-top"><span class="detail-icon di-aqi"><Icon name="material-symbols:eco" /></span><span class="detail-label">空气质量</span></div><div class="aqi-display"><span class="aqi-num weather-aqi-num"></span><span class="aqi-badge weather-aqi-badge"></span></div></div>
        <!-- 云量 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-cloud"><Icon name="material-symbols:cloud" /></span><span class="detail-label">云量</span></div><span class="detail-val weather-cloud"></span></div>
        <!-- 紫外线 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-uv"><Icon name="material-symbols:wb-sunny" /></span><span class="detail-label">紫外线</span></div><span class="detail-val weather-uv"></span></div>
        <!-- 降水量 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-precip"><Icon name="material-symbols:rainy" /></span><span class="detail-label">降水量</span></div><span class="detail-val weather-precip"></span></div>
        <!-- 降水概率 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-precip-prob"><Icon name="material-symbols:umbrella" /></span><span class="detail-label">降水概率</span></div><span class="detail-val weather-precip-prob"></span></div>
        <!-- 日出 / 日落 -->
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-sunrise"><Icon name="material-symbols:wb-twilight" /></span><span class="detail-label">日出</span></div><span class="detail-val weather-sunrise"></span></div>
        <div class="detail-card"><div class="detail-top"><span class="detail-icon di-sunset"><Icon name="material-symbols:wb-twilight-2" /></span><span class="detail-label">日落</span></div><span class="detail-val weather-sunset"></span></div>
        <!-- 污染物浓度（跨两列，内联文本格式） -->
        <div class="detail-card detail-full"><div class="detail-top"><span class="detail-icon di-pollutant"><Icon name="material-symbols:science" /></span><span class="detail-label">污染物浓度</span></div><div class="weather-pollutants"></div></div>
      </div>

      <!-- 底部：更新时间（居中） -->
      <div class="weather-footer flex items-center justify-center pt-2 border-t border-neutral-200/60 dark:border-neutral-700/60">
        <span class="weather-update text-[10px] text-neutral-400"></span>
      </div>
    </div>
  </div>
</WidgetLayout>

<style>
  /* ===== 主天气图标：全部预渲染，按 data-cond 只显示对应那一个 ===== */
  .weather-widget .weather-icon {
    min-width: 2rem;
    height: 2rem;
    font-size: 2rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .weather-widget .weather-icon .w-ic {
    display: none;
    line-height: 1;
  }
  /* 图标 svg 由 <Icon> 子组件渲染，Astro 作用域样式管不到它，
     所以不直接给 svg 写规则：尺寸交给 <Icon> 自带的 width/height="1em"（1em 继承外层字号），
     居中交给这里 flex 对齐（.w-ic / .detail-icon 都是本组件自己的元素） */
  .weather-widget .weather-icon[data-cond="sunny"] [data-ic="sunny"],
  .weather-widget .weather-icon[data-cond="night"] [data-ic="night"],
  .weather-widget .weather-icon[data-cond="partly"] [data-ic="partly"],
  .weather-widget .weather-icon[data-cond="cloudy"] [data-ic="cloudy"],
  .weather-widget .weather-icon[data-cond="overcast"] [data-ic="overcast"],
  .weather-widget .weather-icon[data-cond="fog"] [data-ic="fog"],
  .weather-widget .weather-icon[data-cond="drizzle"] [data-ic="drizzle"],
  .weather-widget .weather-icon[data-cond="rain"] [data-ic="rain"],
  .weather-widget .weather-icon[data-cond="sleet"] [data-ic="sleet"],
  .weather-widget .weather-icon[data-cond="snow"] [data-ic="snow"],
  .weather-widget .weather-icon[data-cond="snow-heavy"] [data-ic="snow-heavy"],
  .weather-widget .weather-icon[data-cond="thunder"] [data-ic="thunder"],
  .weather-widget .weather-icon[data-cond="hot"] [data-ic="hot"],
  .weather-widget .weather-icon[data-cond="cold"] [data-ic="cold"],
  .weather-widget .weather-icon[data-cond="unknown"] [data-ic="unknown"] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 按天气族给图标上色，补回 emoji 的彩色感；选的都是中间调，明暗主题下都压得住。
     灰调那三个（多云/阴/雾）刻意拉开：多云=冷灰蓝、阴=更深的冷灰、雾=偏暖的灰（雾霾/沙尘本就偏暖），
     免得像"全都一个样"；未知用中性深灰，跟雾的暖灰也能分开 */
  .weather-widget .weather-icon[data-cond="sunny"],
  .weather-widget .weather-icon[data-cond="partly"] {
    color: #f59e0b;
  }
  .weather-widget .weather-icon[data-cond="night"] {
    color: #6366f1;
  }
  .weather-widget .weather-icon[data-cond="cloudy"] {
    color: #94a3b8;
  }
  .weather-widget .weather-icon[data-cond="overcast"] {
    color: #475569;
  }
  .weather-widget .weather-icon[data-cond="fog"] {
    color: #a8a29e;
  }
  .weather-widget .weather-icon[data-cond="drizzle"] {
    color: #38bdf8;
  }
  .weather-widget .weather-icon[data-cond="rain"] {
    color: #3b82f6;
  }
  .weather-widget .weather-icon[data-cond="sleet"] {
    color: #60a5fa;
  }
  .weather-widget .weather-icon[data-cond="snow"] {
    color: #0ea5e9;
  }
  .weather-widget .weather-icon[data-cond="snow-heavy"] {
    color: #0284c7;
  }
  .weather-widget .weather-icon[data-cond="thunder"] {
    color: #8b5cf6;
  }
  .weather-widget .weather-icon[data-cond="hot"] {
    color: #ef4444;
  }
  .weather-widget .weather-icon[data-cond="cold"] {
    color: #06b6d4;
  }
  .weather-widget .weather-icon[data-cond="unknown"] {
    color: #6b7280;
  }

  /* ===== 折叠动画 ===== */
  .weather-details {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.3s ease,
      opacity 0.3s ease;
  }
  .weather-details > div {
    overflow: hidden;
    min-height: 0;
  }
  .weather-widget.is-open .weather-details {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* 箭头旋转：收起时朝下（默认），展开时朝上 */
  .weather-toggle .chevron {
    transition: transform 0.3s ease;
  }
  .weather-widget.is-open .weather-toggle .chevron {
    transform: rotate(180deg);
  }

  /* ===== 展开详情网格：3 列，上下布局 ===== */
  .weather-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem 0.625rem;
    padding-top: 0.625rem;
  }

  /* 每个详情卡片：垂直居中，图标+标签在上，数值在下 */
  .detail-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.4rem;
    border-radius: 0.5rem;
    background: var(--color-neutral-50, #fafafa);
    transition: background 0.15s;
  }
  :global(.dark) .detail-card {
    background: var(--color-neutral-800, #262626);
  }

  .detail-card.detail-full {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.75rem;
  }

  /* 上行：图标 + 标签 */
  .detail-top {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--color-neutral-500, #737373);
    white-space: nowrap;
  }
  :global(.dark) .detail-top {
    color: var(--color-neutral-400, #a3a3a3);
  }
  /* 详情卡图标：外面这层 span 是本组件自己的元素，作用域样式管得到；
     里面的 svg 由 <Icon> 渲染，靠 color / font-size 继承拿色和尺寸（<Icon> 自带 1em） */
  .detail-icon {
    font-size: 0.95rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  /* 13 个详情图标各自配色：语义相近的归到同一色族，但彼此都能区分 */
  .detail-icon.di-wind {
    color: #06b6d4;
  } /* 风 · 青 */
  .detail-icon.di-vis {
    color: #6366f1;
  } /* 能见度 · 靛 */
  .detail-icon.di-feel {
    color: #f97316;
  } /* 体感温度 · 橙 */
  .detail-icon.di-humidity {
    color: #3b82f6;
  } /* 湿度 · 蓝 */
  .detail-icon.di-pressure {
    color: #64748b;
  } /* 气压 · 石板灰 */
  .detail-icon.di-aqi {
    color: #22c55e;
  } /* 空气质量 · 绿 */
  .detail-icon.di-cloud {
    color: #94a3b8;
  } /* 云量 · 灰蓝 */
  .detail-icon.di-uv {
    color: #eab308;
  } /* 紫外线 · 黄 */
  .detail-icon.di-precip {
    color: #0ea5e9;
  } /* 降水量 · 天蓝 */
  .detail-icon.di-precip-prob {
    color: #60a5fa;
  } /* 降水概率 · 浅蓝 */
  .detail-icon.di-sunrise {
    color: #f59e0b;
  } /* 日出 · 琥珀 */
  .detail-icon.di-sunset {
    color: #fb7185;
  } /* 日落 · 玫红 */
  .detail-icon.di-pollutant {
    color: #a855f7;
  } /* 污染物 · 紫 */

  /* 下行：数值（加粗、深色） */
  .detail-val {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-neutral-800, #262626);
    line-height: 1.2;
  }
  :global(.dark) .detail-val {
    color: var(--color-neutral-200, #e5e5e5);
  }

  /* ===== 空气质量：数字 + 彩色圆角标签（与其他卡片字号一致） ===== */
  .detail-aqi-card .aqi-display {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    justify-content: center;
  }
  .aqi-num {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-neutral-800, #262626);
    line-height: 1.2;
  }
  :global(.dark) .aqi-num {
    color: var(--color-neutral-100, #e5e5e5);
  }
  .aqi-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.45rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  /* AQI 等级颜色（badge 背景色 + 文字色） */
  .aqi-good { background: #dcfce7; color: #16a34a !important; }
  .aqi-moderate { background: #fef9c3; color: #ca8a04 !important; }
  .aqi-unhealthy-sg { background: #ffedd5; color: #ea580c !important; }
  .aqi-unhealthy { background: #fee2e2; color: #dc2626 !important; }
  .aqi-very-unhealthy { background: #ede9fe; color: #7c3aed !important; }
  .aqi-hazardous { background: #fecaca; color: #991b1b !important; }
  :global(.dark) .aqi-good { background: #166534; color: #86efac !important; }
  :global(.dark) .aqi-moderate { background: #713f12; color: #fde047 !important; }
  :global(.dark) .aqi-unhealthy-sg { background: #7c2d12; color: #fdba74 !important; }
  :global(.dark) .aqi-unhealthy { background: #7f1d1d; color: #fca5a5 !important; }
  :global(.dark) .aqi-very-unhealthy { background: #4c1d95; color: #c4b5fd !important; }
  :global(.dark) .aqi-hazardous { background: #450a0a; color: #f87171 !important; }

  /* ===== 污染物浓度：3列网格，标签在上/数值在下 ===== */
  /* 注意：这些元素由 JS document.createElement 动态创建，
     不带 Astro scoped 属性，必须用 :global() 才能命中 */
  .weather-pollutants {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem 0.5rem;
    width: 100%;
  }
  :global(.pollutant-chip) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
  }
  :global(.pollutant-chip .pc-label) {
    font-size: 0.68rem;
    color: var(--color-neutral-500, #737373);
    line-height: 1.2;
    white-space: nowrap;
  }
  :global(.pollutant-chip .pc-val) {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-neutral-800, #262626);
    line-height: 1.2;
  }
  :global(.dark .pollutant-chip .pc-label) {
    color: var(--color-neutral-400, #a3a3a3);
  }
  :global(.dark .pollutant-chip .pc-val) {
    color: var(--color-neutral-200, #e5e5e5);
  }
</style>

<script define:vars={{ cfg, widgetId }} is:inline>
  const C = JSON.parse(cfg);

  // WMO weather_code -> [图标条件, 中文描述]
  // 图标条件就是 .weather-icon 的 data-cond（对应 WEATHER_ICONS 里的 cond），由 CSS 决定显示哪个图标
  const CODE = {
    0: ["sunny", "晴"],
    1: ["partly", "大致晴朗"],
    2: ["cloudy", "局部多云"],
    3: ["overcast", "阴"],
    45: ["fog", "雾"],
    48: ["fog", "雾凇"],
    51: ["drizzle", "毛毛雨"],
    53: ["drizzle", "小雨"],
    55: ["rain", "中雨"],
    56: ["rain", "冻毛雨"],
    57: ["rain", "冻雨"],
    61: ["rain", "小雨"],
    63: ["rain", "中雨"],
    65: ["rain", "大雨"],
    66: ["rain", "冻雨"],
    67: ["rain", "强冻雨"],
    71: ["snow", "小雪"],
    73: ["snow", "中雪"],
    75: ["snow-heavy", "大雪"],
    77: ["snow", "雪粒"],
    80: ["drizzle", "阵雨"],
    81: ["drizzle", "强阵雨"],
    82: ["thunder", "暴雨"],
    85: ["snow", "阵雪"],
    86: ["snow", "强阵雪"],
    95: ["thunder", "雷阵雨"],
    96: ["thunder", "雷暴伴雹"],
    99: ["thunder", "强雷暴伴雹"],
  };

  // 和风天气天气现象代码 -> [图标条件, 中文描述]（代码段 100+，与 WMO 0-99 不冲突）
  const QW = {
    100: ["sunny", "晴"], 101: ["cloudy", "多云"], 102: ["partly", "少云"], 103: ["partly", "晴间多云"], 104: ["overcast", "阴"],
    150: ["night", "晴"], 151: ["cloudy", "多云"], 152: ["partly", "少云"], 153: ["partly", "晴间多云"],
    300: ["drizzle", "阵雨"], 301: ["drizzle", "强阵雨"], 302: ["thunder", "雷阵雨"], 303: ["thunder", "强雷阵雨"], 304: ["thunder", "雷阵雨伴冰雹"],
    305: ["rain", "小雨"], 306: ["rain", "中雨"], 307: ["rain", "大雨"], 308: ["rain", "极端降雨"], 309: ["drizzle", "细雨"], 310: ["drizzle", "毛毛雨"],
    311: ["rain", "暴雨"], 312: ["rain", "大暴雨"], 313: ["rain", "特大暴雨"], 314: ["rain", "小到中雨"], 315: ["rain", "中到大雨"], 316: ["rain", "大到暴雨"], 317: ["rain", "暴雨到大暴雨"], 318: ["rain", "大暴雨到特大暴雨"],
    350: ["drizzle", "阵雨"], 351: ["drizzle", "强阵雨"], 399: ["rain", "雨"],
    400: ["snow", "小雪"], 401: ["snow", "中雪"], 402: ["snow-heavy", "大雪"], 403: ["snow-heavy", "暴雪"], 404: ["sleet", "雨夹雪"], 405: ["sleet", "雨雪天气"], 406: ["sleet", "阵雨夹雪"], 407: ["snow", "阵雪"], 408: ["snow", "小到中雪"], 409: ["snow", "中到大雪"], 410: ["snow", "大到暴雪"], 456: ["snow", "阵雪"], 457: ["snow", "小雪"], 499: ["snow-heavy", "雪"],
    500: ["fog", "薄雾"], 501: ["fog", "雾"], 502: ["fog", "霾"], 503: ["fog", "扬沙"], 504: ["fog", "浮尘"], 507: ["fog", "沙尘暴"], 508: ["fog", "强沙尘暴"], 509: ["fog", "浓雾"], 510: ["fog", "强浓雾"], 511: ["fog", "中度霾"], 512: ["fog", "重度霾"], 513: ["fog", "严重霾"], 514: ["fog", "大雾"], 515: ["fog", "特强浓雾"],
    900: ["hot", "热"], 901: ["cold", "冷"], 999: ["unknown", "未知"],
  };

  const CACHE_KEY = "firefly-weather-cache";
  const tUnit = C.unit === "fahrenheit" ? "fahrenheit" : "celsius";
  const tempSign = tUnit === "fahrenheit" ? "°F" : "°";

  const FETCH_TIMEOUT = 8000;

  // 带硬性超时的 fetch：每个请求最多 ms 毫秒，超时自动 abort，避免外网源（如 wttr.in）永久 pending、组件卡在"定位中"
  function fetchWithTimeout(url, opts, ms) {
    opts = opts || {};
    ms = ms || FETCH_TIMEOUT;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), ms);
    return fetch(url, Object.assign({}, opts, { signal: ctrl.signal })).finally(() =>
      clearTimeout(timer),
    );
  }

  async function fetchWeather(lat, lon) {
    const url =
      "https://api.open-meteo.com/v1/forecast?latitude=" +
      lat +
      "&longitude=" +
      lon +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,surface_pressure,cloud_cover,precipitation,uv_index,is_day,visibility" +
      "&daily=sunrise,sunset,precipitation_probability_max,temperature_2m_max,temperature_2m_min" +
      "&temperature_unit=" +
      tUnit +
      "&wind_speed_unit=kmh&timezone=auto&forecast_days=1";
    const r = await fetchWithTimeout(url);
    if (!r.ok) throw new Error("weather http " + r.status);
    return r.json();
  }

  // Open-Meteo 空气质量接口（免费，无需 Key）
  // ⚠ 污染物变量名必须用全称 ozone / nitrogen_dioxide / sulphur_dioxide / carbon_monoxide。
  //   写成 o3 / no2 / so2 / co 会被接口判为非法参数，整个请求直接 400，
  //   导致 fetchAirQuality 返回 null → 国外用户的 AQI 卡片和全部污染物恒显示 "--"。
  async function fetchAirQuality(lat, lon) {
    try {
      const r = await fetchWithTimeout(
        "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" +
          lat +
          "&longitude=" +
          lon +
          "&current=us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,sulphur_dioxide,carbon_monoxide",
      );
      if (!r.ok) return null;
      const j = await r.json();
      const c = j && j.current;
      if (!c) return null;
      // 归一化成 render() 认的短名，与和风 / uapis 的 aqi.current 结构保持一致
      return {
        current: {
          us_aqi: c.us_aqi,
          pm2_5: c.pm2_5,
          pm10: c.pm10,
          o3: c.ozone,
          no2: c.nitrogen_dioxide,
          so2: c.sulphur_dioxide,
          co: c.carbon_monoxide,
        },
      };
    } catch {
      return null;
    }
  }

  // 风向角度 → 中文方位
  function windDir(deg) {
    const dirs = ["北", "东北", "东", "东南", "南", "西南", "西", "西北"];
    // 每 45° 一档，22.5° 为分界线（北风范围：348.75° ~ 11.25°）
    const i = Math.round(((deg + 180 / 8) % 360) / 45) % 8;
    return dirs[i];
  }

  // 风速 km/h → 蒲福风力等级
  function beaufort(kmh) {
    if (kmh < 1) return 0;
    if (kmh <= 5) return 1;
    if (kmh <= 11) return 2;
    if (kmh <= 19) return 3;
    if (kmh <= 28) return 4;
    if (kmh <= 38) return 5;
    if (kmh <= 49) return 6;
    if (kmh <= 61) return 7;
    if (kmh <= 74) return 8;
    if (kmh <= 88) return 9;
    if (kmh <= 102) return 10;
    if (kmh <= 117) return 11;
    return 12;
  }

  // 风向文本（如"东北风"）→ 角度（uapis.cn 等只给文字风向的接口用）
  function dirTextToDeg(t) {
    const m = { 东北: 45, 东南: 135, 西南: 225, 西北: 315, 北: 0, 东: 90, 南: 180, 西: 270 };
    if (!t) return 0;
    // 先匹配两字方向，再匹配单字，避免"东北风"被"北"抢先
    const order = ["东北", "东南", "西南", "西北", "北", "东", "南", "西"];
    for (const k of order) if (t.indexOf(k) >= 0) return m[k];
    return 0;
  }

  // 风力等级文本（如"3级"）→ 近似 km/h（取蒲福级中点），用于 beaufort 反推等级
  function windPowerToKmh(p) {
    const m = p && p.match(/(\d+)/);
    const lvl = m ? Math.min(Number(m[1]), 12) : 0;
    const tbl = [0, 3, 8, 15, 24, 33, 44, 56, 68, 82, 96, 110, 120];
    return tbl[lvl] != null ? tbl[lvl] : 0;
  }

  // US AQI → 中文等级 + 颜色标签
  function aqiLabel(usAqi) {
    if (usAqi == null || isNaN(usAqi)) return { text: "--", cls: "" };
    if (usAqi <= 50) return { text: usAqi + " 优", cls: "aqi-good" };
    if (usAqi <= 100) return { text: usAqi + " 良", cls: "aqi-moderate" };
    if (usAqi <= 150) return { text: usAqi + " 轻度污染", cls: "aqi-unhealthy-sg" };
    if (usAqi <= 200) return { text: usAqi + " 中度污染", cls: "aqi-unhealthy" };
    if (usAqi <= 300) return { text: usAqi + " 重度污染", cls: "aqi-very-unhealthy" };
    return { text: usAqi + " 严重污染", cls: "aqi-hazardous" };
  }

  // 取站点当前语言 → 映射成地理编码接口的语言码
  // 跟随 Firefly 的 i18n：html lang 会变（zh-CN/zh-TW/en/ja/ko/ru），
  // 城市名自动跟随站点语言，不写死简体
  function getGeocodeLang() {
    const lang = (document.documentElement.lang || "zh-CN").toLowerCase();
    if (lang.startsWith("zh")) {
      // ⚠ BigDataCloud 只认 zh-Hans/zh-Hant，传 zh-CN 或 zh 会返回繁体（实测"欽北區"）
      if (lang.includes("tw") || lang.includes("hk") || lang.includes("hant")) return "zh-Hant";
      return "zh-Hans";
    }
    if (lang.startsWith("en")) return "en";
    if (lang.startsWith("ja")) return "ja";
    if (lang.startsWith("ko")) return "ko";
    if (lang.startsWith("ru")) return "ru";
    // BigDataCloud 只认 zh-Hans / zh-Hant，其余罕见语言兜底回简体（注释见上）
    return "zh-Hans";
  }

  // 免费反向地理编码（无需 Key），把坐标转成城市名
  async function reverseGeocode(lat, lon, lang) {
    try {
      const r = await fetchWithTimeout(
        "https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" +
          lat +
          "&longitude=" +
          lon +
          "&localityLanguage=" + encodeURIComponent(lang),
      );
      if (!r.ok) return null;
      return r.json();
    } catch {
      return null;
    }
  }

  // 坐标是否在中国大陆（粗略包围盒）：纬度 18~54N，经度 73~135E
  function isInChina(lat, lon) {
    return lat >= 18 && lat <= 54 && lon >= 73 && lon <= 135;
  }

  // 行政区划后缀归一化：三个数据源对后缀的处理各不相同
  //   和风  -> "钦州" / "钦北"（无后缀，但"浦东新区"又带后缀）
  //   uapis -> "钦州市" / "钦北区"（带后缀）
  //   BDC   -> "钦州市" / "钦北区"（带后缀）
  // 统一剥成短名，否则同一个地方在不同源之间会显示成两种写法。
  // 反向补后缀行不通：无法判断"钦北"是区还是县、"昆山"是市还是区，猜错更糟。
  function stripAdm(s) {
    if (!s) return "";
    const raw = String(s).trim();
    if (raw === "市辖区") return ""; // 无意义的占位，直接丢掉
    // 这些后缀是专名的一部分，剥了就错（"神农架林区"→"神农架林"）
    if (/(自治州|自治县|自治区|特别行政区|林区|矿区|特区)$/.test(raw)) return raw;
    // 两字后缀先剥，否则"浦东新区"会被下面的"区"切成"浦东新"
    let t = raw.replace(/(新区|地区|盟)$/, "");
    // ⚠ 绝不能剥"州"：钦州/苏州/广州/杭州 全会毁掉
    t = t.replace(/(市|区|县|旗)$/, "");
    // 剥完只剩一个字（"蓟县"→"蓟"）说明剥过头了，回退原值
    return t.length >= 2 ? t : raw;
  }

  // 和风地理编码结果整理成"城市+区"（adm2=市, name=区/县）
  function formatCity(adm1, adm2, name) {
    const a2 = stripAdm(adm2);
    const nm = stripAdm(name);
    if (nm && a2 && nm !== a2) {
      if (a2.includes(nm)) return a2; // "北京" ⊇ "北京" → 不重复
      if (nm.includes(a2)) return nm; // name 已含市名 → 直接用
      return a2 + nm; // 钦州 + 钦北
    }
    return nm || a2 || stripAdm(adm1) || "";
  }

  // 和风空气质量等级（中文 AQI 的 category）-> 颜色类
  function mapCategory(cat) {
    if (cat === "优") return "aqi-good";
    if (cat === "良") return "aqi-moderate";
    if (cat === "轻度污染") return "aqi-unhealthy-sg";
    if (cat === "中度污染") return "aqi-unhealthy";
    if (cat === "重度污染") return "aqi-very-unhealthy";
    if (cat === "严重污染") return "aqi-hazardous";
    return "";
  }

  // 和风天气（实时优先，7 天兜底）：
  //   /weather/v1/current  实时天气（温度/体感/湿度/风/压/能见度/云量/紫外/降水）
  //   /weather/v1/hourly   逐小时（取今日最高/最低温、最大降水概率）
  //   /v7/astronomy/sun    日出日落
  //   /v7/weather/7d       7 天预报当日（实时缺字段时兜底：最高/最低温、日出日落）
  //   /airquality/v1/current + /geo/v2/city/lookup  空气质量 + 城市（到区）
  // 全部用 API Key（?key=）鉴权，归一化成与 Open-Meteo 相同结构，render() 无需区分数据源
  async function fetchQWeather(lat, lon, key) {
    const loc = lon + "," + lat;
    const base = (C.qweatherHost || "https://api.qweather.com/v7").replace(/\/$/, "");
    const geoBase = (C.qweatherGeoHost || "https://geoapi.qweather.com/v2").replace(/\/$/, "");
    // 实时天气 / 空气质量 走独立根路径（去掉 /v7），同样用 API Key（?key=）鉴权
    const aqHost = base.replace(/\/v7$/, "");
    // astronomy 接口要紧凑日期 YYYYMMDD
    const now = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    const ymd = "" + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate());
    // 本地"今天"日期串，用来从 hourly 24h（UTC）里筛出属于今天的数据
    const todayKey = now.getFullYear() + "-" + pad(now.getMonth() + 1) + "-" + pad(now.getDate());

    const [curR, hrR, d7R, aqR, geoR, sunR] = await Promise.all([
      fetchWithTimeout(aqHost + "/weather/v1/current/" + lat + "/" + lon + "?key=" + key),
      fetchWithTimeout(aqHost + "/weather/v1/hourly/" + lat + "/" + lon + "?key=" + key),
      fetchWithTimeout(base + "/weather/7d?location=" + encodeURIComponent(loc) + "&key=" + key),
      fetchWithTimeout(aqHost + "/airquality/v1/current/" + lat + "/" + lon + "?key=" + key),
      fetchWithTimeout(geoBase + "/city/lookup?location=" + encodeURIComponent(loc) + "&key=" + key),
      // ⚠ base 末尾本来就是 /v7，这里不能再写一遍 /v7，否则拼出 /v7/v7/... 直接 404
      fetchWithTimeout(base + "/astronomy/sun?location=" + encodeURIComponent(loc) + "&date=" + ymd + "&key=" + key),
    ]);
    if (!curR.ok) throw new Error("qweather current " + curR.status);
    // 注意：实时天气字段直接位于 JSON 顶层，没有 now/current 包裹键
    const curJ = await curR.json();
    // 和风 API 顶部的 code 是请求状态码：200=成功，其余都算失败（401 鉴权失败 / 429 限流 / 404 无数据 / 500 等）。
    // 只认 200 才算“取到正确数据”；错误 JSON（即便 HTTP 200）也抛错，让 pickSource 继续试下一个源，
    // 否则会把鉴权失败/错误响应当成“有参数”渲染出 NaN°、一堆 --。
    if (curJ.code == null || String(curJ.code) !== "200") {
      throw new Error("qweather current code " + curJ.code);
    }
    const hr = hrR.ok ? await hrR.json() : null;
    const d7 = d7R.ok ? await d7R.json() : null;
    const aq = aqR.ok ? await aqR.json() : null;
    const geo = geoR.ok ? await geoR.json() : null;
    const sun = sunR.ok ? await sunR.json() : null;

    // 7 天预报当日数据，作为实时缺字段时的兜底（7 天无降水概率字段）
    const day0 = (d7 && d7.daily && d7.daily[0]) || {};

    const cond = curJ.condition || {};

    // 归一化 current（字段名对齐 Open-Meteo）
    // 单位差异：湿度 0~1→%，云量 0~1→%，风速 m/s→km/h（render 用 beaufort），能见度已是米
    const cur = {
      temperature_2m: Number(curJ.temperature?.value),
      apparent_temperature: Number(curJ.feelsLike?.value),
      relative_humidity_2m: Math.round(Number(curJ.humidity) * 100),
      weather_code: Number(cond.code), // 和风代码（字符串→数字），render 用 QW/CODE 映射
      wind_direction_10m: Number(curJ.wind?.direction?.degree),
      wind_speed_10m: Number(curJ.wind?.speed?.value) * 3.6, // m/s → km/h
      surface_pressure: Number(curJ.pressure?.value),
      cloud_cover: Math.round(Number(curJ.cloudCover) * 100), // 0~1 → %
      visibility: Number(curJ.visibility?.value), // 米
      precipitation: Number(curJ.precipitation?.amount?.value) || 0,
      uv_index: curJ.uvIndex != null ? Number(curJ.uvIndex) : null,
      // 更新时间取 7d 接口的 updateTime（v1 current 的 metadata 里没有时间字段）
      timeText: hhmmFromStamp(d7 && d7.updateTime),
    };

    // 从 hourly 24h 里筛出"今天"，取最高/最低温与最大降水概率
    // precipitation.probability 为 0~1 小数，转成 %
    let tempMax = null,
      tempMin = null,
      popPct = null;
    if (hr && Array.isArray(hr.hours) && hr.hours.length) {
      const todayHours = hr.hours.filter((h) => {
        const d = new Date(h.forecastTime);
        if (isNaN(d.getTime())) return false;
        const k = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        return k === todayKey;
      });
      const src = todayHours.length ? todayHours : hr.hours;
      let mx = -Infinity,
        mn = Infinity,
        popMax = 0;
      src.forEach((h) => {
        const t = Number(h.temperature?.value);
        if (!isNaN(t)) {
          if (t > mx) mx = t;
          if (t < mn) mn = t;
        }
        const p = Number(h.precipitation?.probability);
        if (!isNaN(p) && p > popMax) popMax = p;
      });
      if (mx > -Infinity) tempMax = mx;
      if (mn < Infinity) tempMin = mn;
      popPct = Math.round(popMax * 100);
    }

    // 实时逐小时缺数据时，用 7 天当日最高/最低温兜底
    if (tempMax == null && day0.tempMax != null) tempMax = Number(day0.tempMax);
    if (tempMin == null && day0.tempMin != null) tempMin = Number(day0.tempMin);

    const daily = {
      // 日出日落：实时 astronomy 优先，缺失用 7 天当日兜底（7 天为 HH:mm，render 兼容）
      sunrise: sun && sun.sunrise ? [sun.sunrise] : day0.sunrise ? [day0.sunrise] : [],
      sunset: sun && sun.sunset ? [sun.sunset] : day0.sunset ? [day0.sunset] : [],
      // 降水概率仅实时逐小时有（7 天无该字段），缺失则留空显示 "--"
      precipitation_probability_max: popPct != null ? [popPct] : [],
      temperature_2m_max: tempMax != null ? [tempMax] : [],
      temperature_2m_min: tempMin != null ? [tempMin] : [],
    };

    // 归一化 aqi（和风空气质量 v1：indexes[0] 为综合 AQI，pollutants[] 为各项浓度）
    let aqi = null;
    if (aq && aq.indexes && aq.indexes[0]) {
      const idx = aq.indexes[0];
      const ps = aq.pollutants || [];
      const conc = (code) => {
        const p = ps.find((x) => x.code === code);
        return p && p.concentration && p.concentration.value != null ? Number(p.concentration.value) : null;
      };
      aqi = {
        current: {
          label: idx.category || "--",
          cls: mapCategory(idx.category),
          aqi: idx.aqi != null ? Number(idx.aqi) : null,
          pm2_5: conc("pm2p5"),
          pm10: conc("pm10"),
          o3: conc("o3"),
          no2: conc("no2"),
          so2: conc("so2"),
          co: conc("co"),
        },
      };
    }

    // 城市名（到区）
    let city = C.defaultCity;
    if (geo && geo.location && geo.location[0]) {
      const g = geo.location[0];
      city = formatCity(g.adm1, g.adm2, g.name) || C.defaultCity;
    }

    return { cur, daily, aqi, city };
  }

  // uapis.cn：国内第一数据源，完全免费、无需 Key、单接口返回全部数据
  // 浏览器端直接 fetch 即可：该接口会反射 Origin 头返回 Access-Control-Allow-Origin，跨域放行
  // 归一化成与 QWeather / Open-Meteo 相同结构，render() 无需区分数据源
  async function fetchUapis(_lat, _lon) {
    // 不传 city/adcode 时按客户端 IP 自动定位（兜底场景最稳妥）
    const url =
      "https://uapis.cn/api/v1/misc/weather?lang=zh&extended=true&forecast=true&hourly=true";
    const r = await fetchWithTimeout(url, { headers: { Accept: "application/json" } });
    if (!r.ok) throw new Error("uapis " + r.status);
    const j = await r.json();
    if (!j || (j.city == null && j.weather == null)) throw new Error("uapis empty");

    const hourly = Array.isArray(j.hourly_forecast) ? j.hourly_forecast : [];
    const dirDeg = dirTextToDeg(j.wind_direction);
    const windKmh =
      hourly[0] && hourly[0].wind_speed != null
        ? Number(hourly[0].wind_speed)
        : windPowerToKmh(j.wind_power);

    // 归一化 current（字段名对齐 Open-Meteo；weather_icon 复用 QWeather 代码映射）
    const cur = {
      temperature_2m: Number(j.temperature),
      apparent_temperature: j.feels_like != null ? Number(j.feels_like) : Number(j.temperature),
      relative_humidity_2m: Number(j.humidity),
      weather_code: Number(j.weather_icon),
      wind_direction_10m: dirDeg,
      wind_speed_10m: windKmh,
      surface_pressure: Number(j.pressure),
      cloud_cover: Number(j.cloud),
      visibility: Number(j.visibility) * 1000, // km → m 对齐 render
      precipitation: Number(j.precipitation) || 0,
      uv_index: j.uv != null ? Number(j.uv) : null,
      // 更新时间：接口自带 report_time，就是观测地本地时间
      timeText: hhmmFromStamp(j.report_time),
    };

    const f0 = j.forecast && j.forecast[0] ? j.forecast[0] : {};

    // 降水概率：实测 hourly_forecast 的每项只有 time/temperature/weather/wind_*/humidity/
    // feels_like/visibility，压根没有 pop，真正的降水概率在 forecast[].pop（整数百分比）。
    // 这里以 forecast[0].pop 为准，逐小时扫描留作兜底（万一以后接口补上该字段）。
    // 注意用 null 判空而不是 >0，否则今天概率真是 0% 会被当成"没数据"显示成 --
    let popVal = null;
    hourly.forEach((h) => {
      const p = Number(h.pop);
      if (!isNaN(p) && (popVal == null || p > popVal)) popVal = p;
    });
    if (popVal == null && f0.pop != null && !isNaN(Number(f0.pop))) popVal = Number(f0.pop);

    const daily = {
      // 日出日落来自 forecast[0]（HH:mm）
      sunrise: f0.sunrise ? [f0.sunrise] : [],
      sunset: f0.sunset ? [f0.sunset] : [],
      precipitation_probability_max: popVal != null ? [Math.round(popVal)] : [],
      temperature_2m_max: j.temp_max != null ? [Number(j.temp_max)] : [],
      temperature_2m_min: j.temp_min != null ? [Number(j.temp_min)] : [],
    };

    // 归一化 aqi（air_pollutants 各项浓度；co 有的数据源不返回）
    const ap = j.air_pollutants || {};
    const aqi = {
      current: {
        label: j.aqi_category || "--",
        cls: mapCategory(j.aqi_category),
        aqi: j.aqi != null ? Number(j.aqi) : null,
        pm2_5: ap.pm25 != null ? Number(ap.pm25) : null,
        pm10: ap.pm10 != null ? Number(ap.pm10) : null,
        o3: ap.o3 != null ? Number(ap.o3) : null,
        no2: ap.no2 != null ? Number(ap.no2) : null,
        so2: ap.so2 != null ? Number(ap.so2) : null,
        co: ap.co != null ? Number(ap.co) : null,
      },
    };

    // 城市名：接口按 IP 定位会同时给 province / city / district
    // 走 stripAdm 剥掉"市/区"后缀，输出跟和风的 formatCity 完全一致（钦州钦北）
    const city = (() => {
      const c = stripAdm(j.city); // "钦州市" → "钦州"
      const d = stripAdm(j.district); // "钦北区" → "钦北"；"市辖区" → ""
      if (c && d && d !== c && !c.includes(d)) return c + d;
      return c || d || C.defaultCity;
    })();

    return { cur, daily, aqi, city };
  }

  // 统一写入文本，避免 querySelector 返回 null 触发 strictNullChecks 报错
  function setText(parent, sel, val) {
    const n = parent.querySelector(sel);
    if (n) n.textContent = val;
  }

  // 切换主天气图标：只改 data-cond，由 CSS 决定显示哪个预渲染图标（见 WEATHER_ICONS）
  function setCond(parent, sel, cond) {
    const n = parent.querySelector(sel);
    if (n) n.setAttribute("data-cond", cond);
  }

  function render(el, cur, daily, aqi, city) {
    const pair = QW[cur.weather_code] || CODE[cur.weather_code] || ["unknown", "未知"];
    setCond(el, ".weather-icon", pair[0]);
    setText(el, ".weather-temp", Math.round(cur.temperature_2m) + tempSign);
    setText(el, ".weather-city", city);
    setText(el, ".weather-desc", pair[1]);

    // 最高温 / 最低温（收起态显示）
    if (daily?.temperature_2m_max?.[0] != null && daily?.temperature_2m_min?.[0] != null) {
      const tMax = Math.round(daily.temperature_2m_max[0]);
      const tMin = Math.round(daily.temperature_2m_min[0]);
      setText(el, ".weather-temp-range", tMin + "° / " + tMax + "°");
    }

    // 风力：方位 + 等级
    const wDir = windDir(cur.wind_direction_10m);
    const wBft = beaufort(cur.wind_speed_10m);
    setText(el, ".weather-wind-detail", wDir + "风 " + wBft + "级");

    // 能见度（km，保留 1 位小数）
    if (cur.visibility != null) {
      setText(el, ".weather-vis", (cur.visibility / 1000).toFixed(1) + "km");
    }

    // 体感 / 湿度 / 气压 / 云量 / 紫外线 / 降水量
    // 体感温度可能为 null（兜底源缺字段）或 NaN（和风 feelsLike 缺失时 Number(undefined)），
    // 这俩若直接 Math.round 会变 0 / NaN，故判空后显示 "--"
    if (cur.apparent_temperature != null && isFinite(cur.apparent_temperature)) {
      setText(el, ".weather-feel", Math.round(cur.apparent_temperature) + tempSign);
    } else {
      setText(el, ".weather-feel", "--");
    }
    setText(el, ".weather-humidity", Math.round(cur.relative_humidity_2m) + "%");
    if (cur.surface_pressure != null) {
      setText(el, ".weather-pressure", Math.round(cur.surface_pressure) + "hPa");
    }
    if (cur.cloud_cover != null) {
      setText(el, ".weather-cloud", Math.round(cur.cloud_cover) + "%");
    }
    if (cur.uv_index != null) {
      setText(el, ".weather-uv", Math.round(cur.uv_index));
    }
    if (cur.precipitation != null) {
      setText(el, ".weather-precip", cur.precipitation.toFixed(1) + "mm");
    }

    // 降水概率（来自 daily；QWeather 7d 无此字段，Open-Meteo 有）
    if (daily?.precipitation_probability_max?.[0] != null) {
      setText(el, ".weather-precip-prob", daily.precipitation_probability_max[0] + "%");
    } else {
      setText(el, ".weather-precip-prob", "--");
    }

    // 日出 / 日落（和风返回 "HH:mm"，Open-Meteo 返回 ISO datetime）
    const fmtTime = (s) => (s.length <= 5 ? s : s.slice(11, 16));
    if (daily?.sunrise?.[0]) {
      setText(el, ".weather-sunrise", fmtTime(daily.sunrise[0]));
    }
    if (daily?.sunset?.[0]) {
      setText(el, ".weather-sunset", fmtTime(daily.sunset[0]));
    }

    // 空气质量 AQI（大数字 + 彩色圆角标签）
    const aqiNumEl = el.querySelector(".weather-aqi-num");
    const aqiBadgeEl = el.querySelector(".weather-aqi-badge");
    // 兼容：缓存可能直接存了 .current 内层对象（无外层 {current:{}} 包裹）
    const aqiRaw = aqi;
    const aqiCur = (aqiRaw && aqiRaw.current) ? aqiRaw.current : ((aqiRaw && typeof aqiRaw.aqi === "number") ? aqiRaw : null);
    if (aqiCur?.label) {
      // 和风：数字 + 分类标签（如 27 + 优）
      if (aqiNumEl) aqiNumEl.textContent = aqiCur.aqi != null ? String(aqiCur.aqi) : "--";
      if (aqiBadgeEl) { aqiBadgeEl.textContent = aqiCur.label; aqiBadgeEl.className = "aqi-badge " + (aqiCur.cls || ""); }
    } else if (aqiCur?.us_aqi != null) {
      // Open-Meteo：用 US AQI 算等级
      const a = aqiLabel(aqiCur.us_aqi);
      if (aqiNumEl) aqiNumEl.textContent = String(aqiCur.us_aqi);
      if (aqiBadgeEl) { aqiBadgeEl.textContent = a.text; aqiBadgeEl.className = "aqi-badge " + a.cls; }
    } else {
      if (aqiNumEl) aqiNumEl.textContent = "--";
      if (aqiBadgeEl) { aqiBadgeEl.textContent = ""; aqiBadgeEl.className = "aqi-badge"; }
    }

    // 污染物浓度（3列网格：标签在上，数值在下）
    const c = aqiCur;
    const pc = el.querySelector(".weather-pollutants");
    if (pc) {
      pc.textContent = "";
      // 每项: [显示名(化学式下标), 数据key, 值格式化函数]
      const items = [
        ["PM\u2082.\u2085", "pm2_5", null],
        ["PM\u2081\u2080", "pm10", null],
        ["O\u2083", "o3", null],
        ["NO\u2082", "no2", null],
        ["SO\u2082", "so2", null],
        ["CO", "co", (v) => (v != null && isFinite(v)) ? (Number.isInteger(Number(v)) ? String(Number(v)) : Number(v).toFixed(1)) : null],
      ];
      const has = items.some(([, k]) => c?.[k] != null);
      if (c && has) {
        items.forEach(([label, key, fmt]) => {
          const val = fmt ? fmt(c?.[key]) : c?.[key];
          const chip = document.createElement("span");
          chip.className = "pollutant-chip";
          const lab = document.createElement("span");
          lab.className = "pc-label";
          lab.innerHTML = label;
          const v = document.createElement("span");
          v.className = "pc-val";
          v.textContent = (val != null && val !== "" && Number(val) === Number(val)) ? String(val) : "--";
          chip.appendChild(lab);
          chip.appendChild(v);
          pc.appendChild(chip);
        });
      } else {
        pc.textContent = "--";
      }
    }

    // 更新时间：用数据源自己的观测/上报时间，而不是设备当前时间
    // （cur.timeText 由各源解析时填好，已经是观测地本地时间的 HH:MM）
    // 拿不到时间就把整行藏掉，别只留一条空的分隔线
    const updEl = el.querySelector(".weather-update");
    const footEl = el.querySelector(".weather-footer");
    if (updEl) updEl.textContent = cur.timeText ? "更新于 " + cur.timeText : "";
    if (footEl) footEl.style.display = cur.timeText ? "" : "none";
  }

  // Open-Meteo 国外源：天气 + 空气质量 + 反向地理编码，打包成一个归一化结果
  // 这样它跟国内源一样是"一个函数返回 {cur,daily,aqi,city}"，能塞进下面的注册表
  async function fetchOpenMeteoSource(lat, lon) {
    const [d, aqi] = await Promise.all([fetchWeather(lat, lon), fetchAirQuality(lat, lon)]);
    let city = C.defaultCity;
    const g = await reverseGeocode(lat, lon, getGeocodeLang());
    if (g) {
      // 同样走 stripAdm，跟国内两个源统一成"钦州钦北"这种短名
      const c = stripAdm(g.city);
      const l = stripAdm(g.locality);
      if (c && l && l !== c) {
        if (l.startsWith(c)) city = l; // locality 已含市名，避免"北京北京朝阳"
        else if (c.includes(l)) city = c;
        // 中文直接拼（上海浦东）；英文拼起来是"ShanghaiPudong Xinqu"，只留市名
        else city = /[\u4e00-\u9fa5]/.test(c + l) ? c + l : c;
      } else {
        city = c || l || stripAdm(g.principalSubdivision) || C.defaultCity;
      }
    }
    // Open-Meteo 的 current.time 已经是观测地本地时间（请求带了 timezone=auto），直接取 HH:MM
    return { cur: { ...d.current, timeText: hhmmFromStamp(d.current.time) }, daily: d.daily, aqi, city };
  }

  // wttr.in：免费免 Key，还带 CORS 头，浏览器直接能 fetch。按经纬度出 JSON
  // 它的天气代码是 weather.com 那套（113=晴），转成 WMO 让 CODE 表能出图标
  const WTTR_WMO = {
    113: 0, 116: 2, 119: 3, 122: 3, 143: 45, 176: 61, 179: 71, 182: 80, 185: 56, 200: 95,
    227: 73, 230: 73, 248: 45, 260: 48, 263: 53, 266: 53, 281: 56, 284: 57, 293: 61, 296: 61,
    299: 63, 302: 63, 305: 65, 308: 65, 311: 66, 314: 67, 317: 67, 320: 71, 323: 71, 326: 71,
    329: 73, 332: 73, 335: 75, 338: 75, 350: 77, 353: 80, 356: 81, 359: 82, 362: 80, 365: 81,
    368: 85, 371: 86, 374: 80, 377: 81, 386: 95, 389: 95, 392: 95, 395: 95,
  };
  // 日出日落是 "06:35 AM" 这种 12 小时制，转成 24 小时给 render
  function ampmToHHmm(s) {
    const m = /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i.exec(s || "");
    if (!m) return null;
    let h = parseInt(m[1], 10);
    const min = m[2];
    if (m[3].toUpperCase() === "PM" && h !== 12) h += 12;
    if (m[3].toUpperCase() === "AM" && h === 12) h = 0;
    return String(h).padStart(2, "0") + ":" + min;
  }

  // 从接口给的时间串里取 "HH:MM"，兼容：
  //   Open-Meteo  "2026-10-02T07:30"
  //   uapis       "2026-10-02 07:25:08"
  //   和风         "2026-10-02T07:25+08:00"（7d 的 updateTime）
  // 这三种都已经（或带着偏移地）是观测地本地时间，直接截第 11~16 位最省事。
  // ⚠ 不要丢给 new Date() 再格式化 —— 那会被设备时区重新解释，正是要修的问题。
  function hhmmFromStamp(s) {
    if (typeof s !== "string" || s.length < 16) return null;
    const hm = s.slice(11, 16);
    return /^\d{2}:\d{2}$/.test(hm) ? hm : null;
  }

  // wttr 的 observation_time 是 UTC（形如 "11:33 PM"），j1 里没有当地时间字段，
  // 只能用「设备当前的 UTC 偏移」把它换算到当地时间（设备与城市同处一个时区时正确）。
  function wttrObsToLocalText(s) {
    const hhmm = ampmToHHmm(s);
    if (!hhmm) return null;
    const parts = hhmm.split(":");
    const d = new Date();
    d.setUTCHours(Number(parts[0]), Number(parts[1]), 0, 0);
    return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
  }
  async function fetchWttr(lat, lon) {
    // ⚠ 路径前不能加冒号：wttr.in 把 /:xxx 视为内部特殊页，会忽略坐标返回固定地点的天气
    const r = await fetchWithTimeout("https://wttr.in/" + lat + "," + lon + "?format=j1");
    if (!r.ok) throw new Error("wttr.in " + r.status);
    const d = await r.json();
    const c = d.current_condition && d.current_condition[0];
    if (!c) throw new Error("wttr.in 无当前天气");
    const w0 = d.weather && d.weather[0];
    const astro = w0 && w0.astronomy && w0.astronomy[0];
    // 逐小时里的降雨概率取个最大值，填到 daily（没有就空着，render 显示 --）
    let pop = 0;
    if (w0 && Array.isArray(w0.hourly)) {
      for (const h of w0.hourly) {
        const p = parseInt(h.chanceofrain, 10);
        if (!isNaN(p) && p > pop) pop = p;
      }
    }
    const cur = {
      weather_code: WTTR_WMO[parseInt(c.weatherCode, 10)] != null ? WTTR_WMO[parseInt(c.weatherCode, 10)] : 3,
      temperature_2m: Number(c.temp_C),
      apparent_temperature: Number(c.FeelsLikeC),
      relative_humidity_2m: Number(c.humidity),
      wind_direction_10m: Number(c.winddirDegree),
      wind_speed_10m: Number(c.windspeedKmph), // 已经是 km/h，beaufort 直接用
      visibility: Number(c.visibility) * 1000,  // km → m，对齐 render
      surface_pressure: Number(c.pressure),
      cloud_cover: Number(c.cloudcover),
      uv_index: Number(c.uvIndex),
      precipitation: Number(c.precipMM) || 0,
      // wttr 只给 UTC 的 observation_time（j1 里没有当地时间字段），换算到当地时间
      timeText: wttrObsToLocalText(c.observation_time),
    };
    const daily = {
      temperature_2m_max: w0 ? [Number(w0.maxtempC)] : [],
      temperature_2m_min: w0 ? [Number(w0.mintempC)] : [],
      sunrise: astro && ampmToHHmm(astro.sunrise) ? [ampmToHHmm(astro.sunrise)] : [],
      sunset: astro && ampmToHHmm(astro.sunset) ? [ampmToHHmm(astro.sunset)] : [],
      precipitation_probability_max: pop > 0 ? [pop] : [],
    };
    const area = d.nearest_area && d.nearest_area[0];
    const city = (area && area.areaName && area.areaName[0] && area.areaName[0].value) || C.defaultCity;
    // 免费接口不带空气质量，aqi 给 null，render 会显示 --
    return { cur, daily, aqi: null, city };
  }

  // 数据源注册表：想加自己的 API，照着 push 一个对象、写个 fetch 函数就行，不用动主流程
  // region: "cn" = 国内, "global" = 国外；数组顺序即优先级：uapis（国内免 Key，第一优先）→ 和风（国内兜底，需 Key）→ Open-Meteo（国外）→ wttr（全球兜底）；enabled 由配置开关控制（和风还需有 Key）
  const SOURCES = [
    { name: "uapis", region: "cn", enabled: C.enableUapis, fetch: (lat, lon) => fetchUapis(lat, lon) },
    { name: "qweather", region: "cn", enabled: C.enableQWeather && !!C.qweatherKey, fetch: (lat, lon) => fetchQWeather(lat, lon, C.qweatherKey) },
    { name: "openmeteo", region: "global", enabled: C.enableOpenMeteo, fetch: (lat, lon) => fetchOpenMeteoSource(lat, lon) },
    { name: "wttr", region: "global", enabled: C.enableWttr, fetch: (lat, lon) => fetchWttr(lat, lon) },
  ];

  // 按坐标判断国内/国外：先试本区 enabled 的源，按 SOURCES 数组顺序依次兜底；本区全失败才跨区兜底。
  // 例：国内定位时优先用 uapis；只有 uapis 关了才轮到和风；两者都关才跨区到 Open-Meteo。
  async function pickSource(lat, lon, region) {
    const primary = SOURCES.filter((s) => s.region === region && s.enabled);
    const fallback = SOURCES.filter((s) => s.region !== region && s.enabled);
    const order = primary.concat(fallback);
    if (order.length === 0) throw new Error("没有启用任何天气源");
    let lastErr;
    for (const s of order) {
      try {
        const data = await s.fetch(lat, lon);
        if (data && data.cur) return data;
      } catch (e) {
        lastErr = e;
        console.warn("[weather] 数据源 " + s.name + " 失败，尝试下一个：", e);
      }
    }
    throw lastErr || new Error("所有数据源都失败了");
  }

  // 带硬性超时的定位：getCurrentPosition 的 timeout 选项在不少环境下不靠谱，
  // 这里用 Promise + setTimeout 兜底，最多等 5 秒，超时/失败一律回退 null（走默认城市）
  async function getPosition() {
    if (!C.autoLocate || !navigator.geolocation) return null;
    return new Promise((res) => {
      let done = false;
      const finish = (v) => {
        if (!done) {
          done = true;
          res(v);
        }
      };
      const timer = setTimeout(() => finish(null), 5000);
      try {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            clearTimeout(timer);
            finish(pos);
          },
          () => {
            clearTimeout(timer);
            finish(null);
          },
          { timeout: 5000, maximumAge: 10 * 60 * 1000 },
        );
      } catch {
        clearTimeout(timer);
        finish(null);
      }
    });
  }

  // 全部数据源失败保底：直接隐藏整个组件（含标题），不留"获取失败"占位或"半旧数据"
  // root 即 WidgetLayout 根（id=widgetId），display:none 把它整块（标题 + 内容）一起收掉
  function hideWeatherWidget(root) {
    if (!root) return;
    root.style.display = "none";
  }

  async function initWeather() {
    const root = document.getElementById(widgetId);
    if (!root) return;
    const el = root.querySelector("[data-widget]");
    if (!el) return;

    // 折叠/展开按钮（header 右侧）：切换详情区
    const toggle = root.querySelector(".weather-toggle");
    if (toggle && !toggle.dataset.bound) {
      toggle.dataset.bound = "1";
      toggle.addEventListener("click", () => {
        const open = el.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "收起天气详情" : "展开天气详情");
      });
    }

    // 10 分钟内读缓存，避免反复弹定位授权 / 重复请求接口
    const cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      try {
        const o = JSON.parse(cached);
        const cc = o.cur || o.current;
        // 顺手校验 timeText 这个字段"存在"：加"更新于"之前的旧缓存里没有它，
        // 直接渲染会得到一行空的更新时间。这种旧缓存当过期处理，走一次真实请求补上。
        // 注意判的是 key 存在（新缓存里 timeText 可能是 null，那也算有效，别再重复请求）。
        if (Date.now() - o.t < 10 * 60 * 1000 && cc && "timeText" in cc) {
          render(el, cc, o.daily, o.aqi, o.city);
          return;
        }
      } catch {}
    }

    let lat, lon;

    const p = await getPosition();
    if (p) {
      lat = p.coords.latitude;
      lon = p.coords.longitude;
    }
    if (lat == null) {
      lat = C.defaultLat;
      lon = C.defaultLon;
    }

    try {
      // 按坐标判断国内/国外，从注册表里挑一个能用的源（本区优先，失败再试其它区兜底）
      const region = isInChina(lat, lon) ? "cn" : "global";
      const data = await pickSource(lat, lon, region);
      render(el, data.cur, data.daily, data.aqi, data.city);
      localStorage.setItem(
        CACHE_KEY,
        JSON.stringify({ t: Date.now(), cur: data.cur, daily: data.daily, aqi: data.aqi, city: data.city }),
      );
    } catch {
      // 所有数据源都取不到数据 → 保底隐藏整个组件，不残留空白占位
      hideWeatherWidget(root);
    }
  }

  // 首屏兜底：astro:page-load 在脚本执行前就已派发时会“错过”监听，
  // 导致 initWeather 永不触发、一直卡在“定位中”。这里直接执行一次，
  // 并用 ran 标记防止与后续 astro:page-load 重复渲染。
  let ran = false;
  function runWeather() {
    if (ran) return;
    ran = true;
    initWeather();
  }

  // 首屏直接跑（侧边栏 DOM 已就绪），保证一定能渲染出数据
  runWeather();
  // Swup 每次 SPA 导航都会派发，保证脚本重入（已渲染过的页面会被 ran 拦掉）
  document.addEventListener("astro:page-load", runWeather);
</script>