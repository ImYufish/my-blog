---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import {
	live2dWidgetConfig,
	navbarMode,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	heading?: string;
}

const backgroundImages = getBackgroundImages();

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
	heading,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const banner = getBannerVisibilityState({
	isHomePage: isHomePageCheck,
	isPostPage,
	title,
	bannerPostMeta,
});
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	effectiveIsBothSidebars,
	effectiveHasLeftComponents,
	effectiveHasRightComponents,
	gridCols,
	sidebarClass,
	rightSidebarClass,
	staticBarClass,
	footerClassName,
	mobileShowSidebar,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogImageAlt={ogImageAlt} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={navbarWidthFull} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<!-- Main content -->
<div class="content-panel absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-enable={sidebarLayoutConfig.enable ? "true" : "false"}
          data-grid-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{heading || title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

            {/* 移动端底部组件 - 768px及以下显示 */}
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
					<SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!-- 移动端导航抽屉：渲染为 <body> 直系子元素，脱离导航栏的 transform 包含块才能铺满视口 -->
<NavMenuPanel links={resolveNavMenuLinks()} />

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->


</Layout>
<style is:global>
  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out,
                transform 0.35s ease-in-out;
  }

  @keyframes swupFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.95;
    }
  }

  .hitokoto-inline {
    display: block;
    margin: 1rem 0;
    padding: 0.6rem 1rem;
    border-left: 3px solid var(--primary, #6366f1);
    background: color-mix(in srgb, var(--primary, #6366f1) 8%, transparent);
    border-radius: 0.5rem;
    font-style: italic;
    color: var(--color-neutral-700, #404040);
    word-break: break-word;
  }
  span.hitokoto-inline {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 0;
    color: inherit;
  }
  /* 底部 footer 内的一言：去掉边框/背景，改成居中浅色小字，融入备案信息区 */
  .hitokoto-inline.hitokoto-footer {
    display: block;
    margin: 0.6rem auto 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 0;
    font-style: italic;
    font-size: 0.8rem;
    color: var(--color-neutral-500, #737373);
    text-align: center;
    max-width: 42rem;
  }
  /* 横幅一言打字机光标（独立 keyframes，避免与 TypewriterText 的 blink 冲突） */
  #banner-subtitle.hitokoto-tw-cursor::after {
    content: "|";
    margin-left: 2px;
    animation: hitokoto-blink 1s steps(1, end) infinite;
  }
  @keyframes hitokoto-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

</style>
    <script>
        import { getRandomHitokoto, formatHitokoto } from "@/utils/hitokoto";
        import { hitokotoConfig, HITOKOTO_CAT_NAMES } from "@/config/hitokotoConfig";

        // 横幅一言循环打字机：拉一条→逐字打出来→停留→往回删→拉下一条，无限轮播
        // 用递增 token 在 Swup 重入/页面切换时作废上一段动画，避免新旧两段打架
        let _bannerTwToken = 0;
        let _bannerTwTimer: number | null = null;

        function clearBannerTw() {
            _bannerTwToken++;
            if (_bannerTwTimer !== null) {
            clearTimeout(_bannerTwTimer);
            _bannerTwTimer = null;
            }
        }

        function sleepBanner(ms: number): Promise<void> {
            return new Promise((resolve) => {
            _bannerTwTimer = window.setTimeout(resolve, ms);
            });
        }

        // 副标题高度不再由 JS 控制：position:absolute 脱离文档流（见 banner-title.css），
        // 高度变化只向下溢出，标题零位移。下方仅打字机轮播逻辑。

        // 一言加载失败回退：关回退开关→显示主题预设池（模板已预渲染 #banner-subtitle-fallback，自带 TypewriterText 或静态）；
        // 开回退开关且连本地回退也取不到→没有可用数据，隐藏一言槽与预设回退槽（不显示错误文案）
        function fallbackBannerSubtitle(el: HTMLElement) {
            clearBannerTw(); // 作废可能还在跑的一言打字机（递增 token + 清计时器）；TypewriterText 有独立计时器，不受影响
            const fallback = document.getElementById("banner-subtitle-fallback");
            if (!hitokotoConfig.fallbackToLocal) {
                // 预设池已在模板渲染好（沿用 ht?.typewriter 配置），此处只切显隐
                if (fallback) {
                    el.style.display = "none";   // 隐藏一言文本槽
                    fallback.style.display = ""; // 显示预设池：TypewriterText 自动接管逐字打，或静态单句
                    return;
                }
                el.style.display = "none"; // 兜底：没有预设回退节点则直接隐藏一言槽
            } else {
                // 开回退开关还走到这，说明远程挂且本地回退也取不到——没数据就隐藏副标题，留空占位保标题原位
                el.style.display = "none";
                if (fallback) fallback.style.display = "none";
            }
        }

        async function bannerHitokotoLoop(
            el: HTMLElement,
            opts: {
            eff: Record<string, boolean>;
            showSource: boolean;
            showAuthor: boolean;
            showCategory: boolean;
            typeSpeed: number;
            deleteSpeed: number;
            pause: number;
            minLength: number;
            maxLength: number;
            }
        ) {
            const myToken = _bannerTwToken;
            const fetchOne = () =>
            getRandomHitokoto({ ...hitokotoConfig, enableCategories: opts.eff, minLength: opts.minLength, maxLength: opts.maxLength }).then((item) => {
                const suffix = formatHitokoto(item, {
                showSource: opts.showSource,
                showAuthor: opts.showAuthor,
                showCategory: opts.showCategory,
                catNames: HITOKOTO_CAT_NAMES,
                });
                return item.hitokoto + (suffix ? "　" + suffix : "");
            });

            while (myToken === _bannerTwToken) {
            let full: string;
            try {
                full = await fetchOne();
            } catch (e) {
                if (myToken !== _bannerTwToken) return;
                console.warn("[banner-hitokoto] 加载失败：", e);
                fallbackBannerSubtitle(el);
                return;
            }
            if (myToken !== _bannerTwToken) return;
            const chars = Array.from(full); // 按码点切分，避免 CJK/emoji 截断
            el.textContent = "";
            el.classList.add("hitokoto-tw-cursor");
            // 正向逐字打出
            for (let i = 1; i <= chars.length; i++) {
                if (myToken !== _bannerTwToken) return;
                el.textContent = chars.slice(0, i).join("");
                await sleepBanner(opts.typeSpeed);
            }
            // 一句打完，停留一会儿
            await sleepBanner(opts.pause);
            if (myToken !== _bannerTwToken) return;
            // 往回逐字删除（i >= 0：把最后一个字也删干净，否则会残留一个字）
            for (let i = chars.length - 1; i >= 0; i--) {
                if (myToken !== _bannerTwToken) return;
                el.textContent = chars.slice(0, i).join("");
                await sleepBanner(opts.deleteSpeed);
            }
            el.classList.remove("hitokoto-tw-cursor");
            // 删完后停顿，再拉下一条
            await sleepBanner(opts.pause);
            }
        }


        function renderBannerHitokoto() {
            const el = document.getElementById("banner-subtitle");
            if (!el || el.dataset.hitokoto !== "1") return;
            // 横幅展示参数/分类/打字机直接读一言配置中心，不再经 data 属性中转
            const b = hitokotoConfig.banner;
            // 横幅独立长度范围：banner 块设了就只用它（横幅单独约束），否则沿用全局
            const bMin = b.minLength > 0 ? b.minLength : hitokotoConfig.minLength;
            const bMax = b.maxLength > 0 ? b.maxLength : hitokotoConfig.maxLength;
            const showSource = b.showSource;
            const showAuthor = b.showAuthor;
            const showCategory = b.showCategory;
            // 横幅分类白名单：指定则只从这些分类抽，并与总开关取交集；空数组则用全部
            const master = hitokotoConfig.enableCategories as Record<string, boolean>;
            const eff = b.categories && b.categories.length
            ? b.categories.reduce((acc, c) => {
                acc[c] = !!master[c];
                return acc;
                }, {} as Record<string, boolean>)
            : master;
            clearBannerTw();
            if (!b.typewriter) {
            // 关掉打字机：拉一条直接显示，不打字也不循环
            getRandomHitokoto({ ...hitokotoConfig, enableCategories: eff, minLength: bMin, maxLength: bMax })
                .then((item) => {
                if (el.dataset.hitokoto !== "1") return;
                const suffix = formatHitokoto(item, {
                    showSource,
                    showAuthor,
                    showCategory,
                    catNames: HITOKOTO_CAT_NAMES,
                });
                el.textContent = item.hitokoto + (suffix ? "　" + suffix : "");
                })
                .catch((e) => {
                console.warn("[banner-hitokoto] 加载失败：", e);
                fallbackBannerSubtitle(el);
                });
            return;
            }
            // 打字机：拉一条→打完→删→拉下一条，无限轮播
            bannerHitokotoLoop(el, {
            eff,
            showSource,
            showAuthor,
            showCategory,
            typeSpeed: b.typewriterSpeed,
            deleteSpeed: b.typewriterDeleteSpeed,
            pause: b.typewriterPause,
            minLength: bMin,
            maxLength: bMax,
            });
        }

        // Swup 页面过渡会替换 DOM 但不重载脚本，靠此事件重新绑定到新节点；初次加载也会触发
        document.addEventListener("astro:page-load", renderBannerHitokoto);
        renderBannerHitokoto();

    </script>
<script>
  // 这一段接在上面 <style> 段之后，同样粘到文件最末尾（文章内/页脚填充脚本）：
  import { getRandomHitokoto, formatHitokoto } from "@/utils/hitokoto";
  import { hitokotoConfig, HITOKOTO_CAT_NAMES } from "@/config/hitokotoConfig";

  function renderInlineHitokoto(el: HTMLElement) {
    if (el.dataset.filled === "1") return;
    el.dataset.filled = "1";
    // 分类白名单：data-type 可填 "i" 或 "i,d"，与总开关取交集
    const typeVal = el.dataset.type || "";
    const cats = typeVal ? typeVal.split(/[,\s]+/).filter(Boolean) : [];
    const master = hitokotoConfig.enableCategories as Record<string, boolean>;
    const eff = cats.length
      ? cats.reduce((acc, c) => {
          acc[c] = !!master[c];
          return acc;
        }, {} as Record<string, boolean>)
      : master;
    const mode = (el.dataset.mode as "local" | "remote") || hitokotoConfig.bundleSource;
    // 参数开关：写了就用写的值，没写用 hitokotoConfig 默认
    const showSource = el.dataset.source ? el.dataset.source === "true" : hitokotoConfig.showSource;
    const showAuthor = el.dataset.author ? el.dataset.author === "true" : hitokotoConfig.showAuthor;
    const showCategory = el.dataset.category ? el.dataset.category === "true" : hitokotoConfig.showCategory;
    getRandomHitokoto({ ...hitokotoConfig, enableCategories: eff, bundleSource: mode })
      .then((item) => {
        const suffix = formatHitokoto(item, {
          showSource,
          showAuthor,
          showCategory,
          catNames: HITOKOTO_CAT_NAMES,
        });
        const prefix = el.dataset.text ? el.dataset.text + " " : "";
        el.textContent = prefix + item.hitokoto + (suffix ? "　—— " + suffix : "");
      })
      .catch((e) => {
        console.warn("[hitokoto-inline] 加载失败：", e);
        // 走到这里就是所有数据源都拿不到（本地包缺失 / 远程挂且回退本地也挂），
        // 直接隐藏该内联元素，不显示错误文案
        el.style.display = "none";
      });
  }

  function renderAllInlineHitokoto() {
    document.querySelectorAll("[data-hitokoto-inline]").forEach((el) => {
      // 底部 footer 在 Swup 容器之外、跨页面不换 DOM，需每次导航都强制重新拉一条
      if ((el as HTMLElement).classList.contains("hitokoto-footer")) {
        (el as HTMLElement).dataset.filled = "0";
      }
      renderInlineHitokoto(el as HTMLElement);
    });
  }

  // Swup 页面过渡会替换 DOM 但不重载脚本，靠此事件重新绑定到新节点；初次加载也会触发
  document.addEventListener("astro:page-load", renderAllInlineHitokoto);
  renderAllInlineHitokoto();
</script>
