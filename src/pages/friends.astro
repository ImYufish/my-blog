---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 友链数据：优先读取远程 friends.json（实时更新），失败则回退本地 friendsConfig.ts 保底
const items = await loadFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 拉取 check-flink 的 result.json，获取封面截图和延迟状态
interface CheckFlinkStatus {
	name: string;
	link: string;
	latency: number;
	fail_count: number;
	status: string;
	geo_hint: string | null;
	geo_streak: number;
	has_author_link: boolean;
	linkpage: string;
	siteshot: string;
}

let checkFlinkStatusMap: Map<string, CheckFlinkStatus> = new Map();
try {
	const res = await fetch(
		"https://friends.yufish.cn/result.json",
		{ signal: AbortSignal.timeout(15000) },
	);
	if (res.ok) {
		const data = (await res.json()) as {
			link_status?: CheckFlinkStatus[];
		};
		for (const s of data.link_status || []) {
			const key = normalizeMatchUrl(s.link);
			if (key) checkFlinkStatusMap.set(key, s);
		}
	} else {
		console.warn(`[friends] check-flink result.json HTTP ${res.status}`);
	}
} catch (e) {
	console.warn("[friends] fetch check-flink result.json failed:", e);
}

// 远程友链清单（check-flink/static/friends.json），字段与 friendsConfig.ts 保持一致
interface RemoteFriend {
	title: string;
	imgurl: string;
	desc: string;
	siteurl: string;
	tags?: string[];
	linkpage?: string;
	rss?: string;
	weight: number;
	enabled: boolean;
}

// 读取远程友链清单；远程不可用（网络异常 / 404 / 空数据）时回退本地配置，保证构建不中断
async function loadFriends(): Promise<RemoteFriend[]> {
	try {
		const res = await fetch(
			"https://friends.yufish.cn/friends.json",
			{ signal: AbortSignal.timeout(15000) },
		);
		if (res.ok) {
			const data = (await res.json()) as { friends?: RemoteFriend[] };
			const remote = (data.friends || [])
				.filter((f) => f.enabled !== false)
				.sort((a, b) => (b.weight ?? 0) - (a.weight ?? 0));
			if (remote.length > 0) {
				console.log(`[friends] 使用远程 friends.json（${remote.length} 条）`);
				return remote;
			}
			console.warn("[friends] friends.json 为空，回退本地配置");
		} else {
			console.warn(`[friends] friends.json HTTP ${res.status}，回退本地配置`);
		}
	} catch (e) {
		console.warn("[friends] 读取远程 friends.json 失败，回退本地配置:", e);
	}
	return getEnabledFriends();
}

function normalizeMatchUrl(url: string): string {
	return url
		.trim()
		.replace(/^https?:\/\//i, "")
		.replace(/\/$/, "")
		.toLowerCase();
}

function getSiteStatus(item: (typeof items)[number]) {
	return checkFlinkStatusMap.get(normalizeMatchUrl(item.siteurl));
}

function extractHost(url: string): string {
	try {
		return new URL(url).host;
	} catch {
		return url.replace(/^https?:\/\//i, "").replace(/\/$/, "");
	}
}

// 延迟数字配色：绿(快) / 黄(中) / 红(慢或异常) / 黑(无数据)
function latencyColor(
	status: string | undefined,
	latency: number | null,
): string {
	if (status == null || latency == null) return "#6b7280"; // 黑/灰：无数据
	if (status !== "ok") return "#ef4444"; // 红：访问异常
	if (latency < 0.8) return "#22c55e"; // 绿：快
	if (latency <= 2.0) return "#eab308"; // 黄：中
	return "#ef4444"; // 红：慢
}

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon is:inline name="material-symbols:group" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {
          description && (
            <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
              {description}
            </p>
          )
        }
      </div>

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon is:inline
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid my-4">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
              <Icon is:inline name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
          items.map((item) => {
            const status = getSiteStatus(item);
            const cover = status?.siteshot || item.imgurl;
            const latencyMs =
              status?.latency != null ? Math.round(status.latency * 1000) : null;
            const color = latencyColor(status?.status, status?.latency ?? null);
            return (
              <a
                href={item.siteurl}
                target="_blank"
                rel="noopener noreferrer"
                data-tags={item.tags?.join(",")}
                class="friend-card group flex flex-col rounded-xl border border-(--line-divider) hover:border-(--primary) hover:shadow-lg transition-all duration-300 overflow-hidden bg-(--card-bg) relative"
              >
                {/* 顶部封面（纯装饰截图，不放站点名） */}
                <div class="relative h-32 w-full overflow-hidden">
                  <img
                    src={cover}
                    alt={item.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  {/* 封面底部渐变融入卡片背景 */}
                  <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-[var(--card-bg)] to-transparent" />
                  {/* 延迟徽章：数字与原点颜色随状态变化 */}
                  <div class="absolute top-2.5 right-2.5 flex items-center gap-1.5 px-2 py-1 rounded-full bg-black/40 backdrop-blur-sm text-xs font-medium">
                    <span class="w-1.5 h-1.5 rounded-full" style={`background:${color}`} />
                    <span style={`color:${color}`}>{latencyMs != null ? `${latencyMs} MS` : "OFFLINE"}</span>
                  </div>
                </div>

                {/* 主体：圆形头像 + 站点名（加粗变黑） */}
                <div class="p-3 flex items-center gap-3">
                  <div class="relative w-10 h-10 shrink-0 rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                    <img
                      src={item.imgurl}
                      alt={item.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div
                    data-title
                    class="text-sm font-bold text-neutral-900 dark:text-neutral-100 truncate"
                  >
                    {item.title}
                  </div>
                </div>

                {/* 描述：固定两行高度，超两行省略 */}
                {item.desc && (
                  <div
                    data-desc
                    class="px-3 text-xs text-neutral-500 dark:text-neutral-400 leading-5 line-clamp-2 min-h-[2.5rem]"
                    title={item.desc}
                  >
                    {item.desc}
                  </div>
                )}

                {/* 标签：固定底部，保证多行描述也对齐 */}
                {item.tags && item.tags.length > 0 && (
                  <div class="mt-auto px-3 pb-3 pt-2 flex flex-wrap gap-1">
                    {item.tags.slice(0, 3).map((tag) => (
                      <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            );
          })
        }
      </div>

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon is:inline name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");

          filters.forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (cardEl.querySelector("[data-title]")?.textContent || "").toLowerCase();
            const desc = (cardEl.querySelector("[data-desc]")?.textContent || "").toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }
  </script>

  <style is:global>
    .friends-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
    }
  </style>

  <script is:inline>
    // 客户端实时刷新友链：页面加载即 fetch 远程 friends.json / result.json 重渲染，
    // 新申请的友链无需重新构建博客即可出现。失败则沿用构建时 SSR 数据。
    (function () {
      const FRIENDS_URL = "https://friends.yufish.cn/friends.json";
      const RESULT_URL = "https://friends.yufish.cn/result.json";

      function normUrl(u) {
        return (u || "").trim().replace(/^https?:\/\//i, "").replace(/\/$/, "").toLowerCase();
      }
      function latencyColor(status, latency) {
        if (status == null || latency == null) return "#6b7280";
        if (status !== "ok") return "#ef4444";
        if (latency < 0.8) return "#22c55e";
        if (latency <= 2.0) return "#eab308";
        return "#ef4444";
      }
      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }
      function cardHtml(f, rm) {
        const status = rm.get(normUrl(f.siteurl)) || null;
        const cover = status && status.siteshot ? status.siteshot : f.imgurl;
        const latencyMs = status && status.latency != null ? Math.round(status.latency * 1000) : null;
        const color = latencyColor(status && status.status, status ? (status.latency != null ? status.latency : null) : null);
        const tags = (f.tags || []).slice(0, 3).map(function (t) {
          return '<span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400">' + esc(t) + "</span>";
        }).join("");
        const desc = f.desc
          ? '<div data-desc class="px-3 text-xs text-neutral-500 dark:text-neutral-400 leading-5 line-clamp-2 min-h-[2.5rem]" title="' + esc(f.desc) + '">' + esc(f.desc) + "</div>"
          : "";
        const tagBox = f.tags && f.tags.length > 0
          ? '<div class="mt-auto px-3 pb-3 pt-2 flex flex-wrap gap-1">' + tags + "</div>"
          : "";
        return (
          '<a href="' + esc(f.siteurl) + '" target="_blank" rel="noopener noreferrer" data-tags="' + (f.tags || []).join(",") + '" class="friend-card group flex flex-col rounded-xl border border-(--line-divider) hover:border-(--primary) hover:shadow-lg transition-all duration-300 overflow-hidden bg-(--card-bg) relative">' +
            '<div class="relative h-32 w-full overflow-hidden">' +
              '<img src="' + esc(cover) + '" alt="' + esc(f.title) + '" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />' +
              '<div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-[var(--card-bg)] to-transparent"></div>' +
              '<div class="absolute top-2.5 right-2.5 flex items-center gap-1.5 px-2 py-1 rounded-full bg-black/40 backdrop-blur-sm text-xs font-medium">' +
                '<span class="w-1.5 h-1.5 rounded-full" style="background:' + color + '"></span>' +
                '<span style="color:' + color + '">' + (latencyMs != null ? latencyMs + " MS" : "OFFLINE") + "</span>" +
              "</div>" +
            "</div>" +
            '<div class="p-3 flex items-center gap-3">' +
              '<div class="relative w-10 h-10 shrink-0 rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">' +
                '<img src="' + esc(f.imgurl) + '" alt="' + esc(f.title) + '" class="w-full h-full object-cover" loading="lazy" />' +
              "</div>" +
              '<div data-title class="text-sm font-bold text-neutral-900 dark:text-neutral-100 truncate">' + esc(f.title) + "</div>" +
            "</div>" +
            desc +
            tagBox +
          "</a>"
        );
      }
      async function refreshFriends() {
        try {
          const [fr, rr] = await Promise.all([
            fetch(FRIENDS_URL, { cache: "no-store" }),
            fetch(RESULT_URL, { cache: "no-store" }).catch(function () { return null; }),
          ]);
          if (!fr.ok) return;
          const fd = await fr.json();
          const list = (fd.friends || [])
            .filter(function (f) { return f.enabled !== false; })
            .sort(function (a, b) { return (b.weight || 0) - (a.weight || 0); });
          const rm = new Map();
          if (rr && rr.ok) {
            const rd = await rr.json();
            (rd.link_status || []).forEach(function (s) {
              const k = normUrl(s.link);
              if (k) rm.set(k, s);
            });
          }
          const grid = document.querySelector(".friends-grid");
          if (!grid) return;
          if (list.length === 0) {
            grid.innerHTML = '<div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500"><div class="text-sm">暂无友链</div></div>';
          } else {
            grid.innerHTML = list.map(function (f) { return cardHtml(f, rm); }).join("");
          }
          // 重新套用当前筛选 / 搜索
          const active = document.querySelector("friend-filter button[data-active]");
          if (active) active.click();
        } catch (e) {
          console.warn("[friends] 客户端实时刷新失败，沿用构建时数据:", e);
        }
      }
      if (document.readyState !== "loading") refreshFriends();
      else document.addEventListener("DOMContentLoaded", refreshFriends);
    })();
  </script>
</MainGridLayout>
