---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";

// 图片同域反代 / 远程数据源：集中配置在 src/config/friendsConfig.ts 的
// friendsPageConfig.remoteBaseUrl 与 imgProxy（换域名只改配置，不动页面）
const REMOTE_BASE = (
	friendsPageConfig.remoteBaseUrl || "https://fc.yufish.cn"
).replace(/\/$/, "");
const LINK_JSON_URL = `${REMOTE_BASE}/link.json`;
const FRIENDS_JSON_URL = `${REMOTE_BASE}/friends.json`;
const IMG_PROXY_ENABLED = friendsPageConfig.imgProxy?.enabled !== false;
const IMG_PROXY_FROM = friendsPageConfig.imgProxy?.fromHost || "";
const IMG_PROXY_TO = friendsPageConfig.imgProxy?.toHost || "";
function proxyImg(raw: string | undefined) {
	if (!raw || !IMG_PROXY_ENABLED || !IMG_PROXY_FROM || !IMG_PROXY_TO) {
		return raw;
	}
	try {
		const p = new URL(raw);
		if (p.hostname === IMG_PROXY_FROM) {
			p.hostname = IMG_PROXY_TO;
			return p.toString();
		}
	} catch (e) {
		/* 非合法 URL 原样返回 */
	}
	return raw;
}

// 兜底头像：友链封面/头像全部加载失败时的最终兜底（配置优先，否则内置默认）
const DEFAULT_AVATAR =
	friendsPageConfig.defaultAvatar || "https://x1anyu.cn/assets/images/avater.jpeg";

// 构建多级兜底链：primary 是已设置在 <img src> 上的主图，candidates 是依次回退的候选。
// 自动去重并剔除主图本身，返回以 | 分隔的字符串，供前端 error 事件按顺序逐张尝试。
function buildFallbackChain(
	primary: string | undefined,
	candidates: (string | undefined)[],
): string {
	const seen = new Set<string>();
	if (primary) seen.add(primary);
	const out: string[] = [];
	for (const c of candidates) {
		if (!c || seen.has(c)) continue;
		seen.add(c);
		out.push(c);
	}
	return out.join("|");
}

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 友链数据源开关：useRemote 为 false 时强制仅用本地 friendsConfig.ts（不拉远程）
const useRemoteFriends = friendsPageConfig.useRemote !== false;

// 友链数据：优先读取远程 friends.json（实时更新），失败则回退本地 friendsConfig.ts 保底
const items = await loadFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 拉取 Friend-Circle-Lite(fc.yufish.cn) 的 link.json，获取封面截图和延迟状态
interface CheckFlinkStatus {
	name: string;
	link: string;
	latency: number;
	latency_cn?: number; // 国内视角延迟（秒），未部署 EO 时为 -1
	latency_display?: number; // 自动选取的展示延迟：国内/国外源站取更快者，前端展示用
	fail_count: number;
	status: string;
	geo_hint: string | null;
	geo_streak: number;
	has_author_link: boolean;
	linkpage: string;
	siteshot: string;
}

let checkFlinkStatusMap: Map<string, CheckFlinkStatus> = new Map();
try {
	const res = await fetch(LINK_JSON_URL, {
		signal: AbortSignal.timeout(15000),
	});
	if (res.ok) {
		const data = (await res.json()) as {
			link_data?: Array<{
				name: string;
				link: string;
				latency?: number;
				latency_cn?: number;
				latency_display?: number;
				reachable?: boolean;
				has_backlink?: boolean | null;
				link_page?: string;
				siteshot?: string;
			}>;
		};
		for (const s of data.link_data || []) {
			const key = normalizeMatchUrl(s.link);
			if (!key) continue;
			checkFlinkStatusMap.set(key, {
				name: s.name,
				link: s.link,
				latency: s.latency ?? -1,
				latency_cn: s.latency_cn ?? -1,
				latency_display: s.latency_display ?? -1,
				fail_count: 0,
				status: s.reachable ? "ok" : "fail",
				geo_hint: null,
				geo_streak: 0,
				has_author_link: s.has_backlink === true,
				linkpage: s.link_page || "",
				siteshot: s.siteshot || "",
			});
		}
	} else {
		console.warn(`[friends] FCL ${LINK_JSON_URL} HTTP ${res.status}`);
	}
} catch (e) {
	console.warn("[friends] fetch FCL link.json failed:", e);
}

// 远程友链清单（Friend-Circle-Lite 仓库 friends.json，双写格式含 title/siteurl/imgurl），字段与 friendsConfig.ts 保持一致
interface RemoteFriend {
	title: string;
	imgurl: string;
	desc: string;
	siteurl: string;
	tags?: string[];
	linkpage?: string;
	rss?: string;
	weight: number;
	enabled: boolean;
}

// 读取远程友链清单；远程不可用（网络异常 / 404 / 空数据）时回退本地配置，保证构建不中断
async function loadFriends(): Promise<RemoteFriend[]> {
	if (!useRemoteFriends) {
		console.log(
			"[friends] 已配置 useRemote=false，仅使用本地 friendsConfig.ts",
		);
		return getEnabledFriends();
	}
	try {
		const res = await fetch(FRIENDS_JSON_URL, {
			signal: AbortSignal.timeout(15000),
		});
		if (res.ok) {
			const data = (await res.json()) as { friends?: RemoteFriend[] };
			const remote = (data.friends || [])
				.filter((f) => f.enabled !== false)
				.sort((a, b) => (b.weight ?? 0) - (a.weight ?? 0));
			if (remote.length > 0) {
				console.log(`[friends] 使用远程 friends.json（${remote.length} 条）`);
				return remote;
			}
			console.warn("[friends] friends.json 为空，回退本地配置");
		} else {
			console.warn(`[friends] friends.json HTTP ${res.status}，回退本地配置`);
		}
	} catch (e) {
		console.warn("[friends] 读取远程 friends.json 失败，回退本地配置:", e);
	}
	return getEnabledFriends();
}

function normalizeMatchUrl(url: string): string {
	// 远程友链数据有时缺 siteurl/link 字段（如 fc.yufish.cn 的 friends.json 用 link 而非 siteurl），
	// 空值兜底，避免整页渲染崩溃导致构建中断
	if (!url) return "";
	return url
		.trim()
		.replace(/^https?:\/\//i, "")
		.replace(/\/$/, "")
		.toLowerCase();
}

function getSiteStatus(item: (typeof items)[number]) {
	return checkFlinkStatusMap.get(normalizeMatchUrl(item.siteurl));
}

function extractHost(url: string): string {
	try {
		return new URL(url).host;
	} catch {
		return url.replace(/^https?:\/\//i, "").replace(/\/$/, "");
	}
}

// 延迟数字配色：绿(快) / 黄(中) / 红(慢或异常) / 黑(无数据)
function latencyColor(
	status: string | undefined,
	latency: number | null,
): string {
	if (status == null || latency == null) return "#6b7280"; // 黑/灰：无数据
	if (status !== "ok") return "#ef4444"; // 红：访问异常
	if (latency < 0.8) return "#22c55e"; // 绿：快
	if (latency <= 2.0) return "#eab308"; // 黄：中
	return "#ef4444"; // 红：慢
}

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:group" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid my-4">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
              <Icon name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
          items.map((item) => {
            const status = getSiteStatus(item);
            const cover = proxyImg(status?.siteshot) || item.imgurl;
            const coverFallback = status?.siteshot || item.imgurl;
            // 封面兜底链：封面失败 → 友链头像(imgurl) → 兜底头像(配置)
            const coverFallbackChain = buildFallbackChain(cover, [
              coverFallback,
              item.imgurl,
              DEFAULT_AVATAR,
            ]);
            // 头像兜底链：头像失败 → 兜底头像(配置)
            const avatarFallbackChain = buildFallbackChain(item.imgurl, [
              DEFAULT_AVATAR,
            ]);
            // 展示延迟优先用 latency_display（main.py 已按"国内/国外源站取更快者"自动选取），
            // 回退 latency（兼容未部署 EO 或旧 result.json 无该字段的情况）
            const dispLatency =
              status?.latency_display != null && status.latency_display > 0
                ? status.latency_display
                : (status?.latency ?? null);
            const latencyMs =
              dispLatency != null && dispLatency > 0 ? Math.round(dispLatency * 1000) : null;
            const color = latencyColor(
              status?.status,
              dispLatency != null && dispLatency > 0 ? dispLatency : null,
            );
            return (
              <a
                href={item.siteurl}
                target="_blank"
                rel="noopener noreferrer"
                data-tags={item.tags?.join(",")}
                data-m-url={item.siteurl}
                data-m-shot={cover}
                data-m-shot-fb={coverFallbackChain}
                class="friend-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden"
              >
                {/* 背景装饰 - 仅悬停显示（原版效果：主题色淡淡铺一层） */}
                <div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none" />

                {/* 延迟徽章：原版卡片没有，本站按 FCL 数据加，放右上角避开三行文字 */}
                <div class="friend-latency absolute top-2 right-2 z-10 flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-[0.65rem] font-medium">
                  <span
                    class="friend-latency-dot w-1.5 h-1.5 rounded-full"
                    style={`background:${color}`}
                  />
                  <span style={`color:${color}`} class="friend-latency-text">
                    {latencyMs != null ? `${latencyMs} MS` : "OFFLINE"}
                  </span>
                </div>

                {/* 外部链接图标：悬停滑入（原版在右上角，这里下移避开延迟徽章）。
                    直接内联路径而不用 <Icon>：卡片会被 cardHtml() 整块重渲染，
                    走图标组件的话 svg 只存在于 SSR，刷新后就被覆盖掉、线上永远看不到 */}
                <svg
                  class="absolute bottom-2 right-2 w-5 h-5 text-(--primary) opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="m16 8.4l-8.9 8.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7L14.6 7H7q-.425 0-.712-.288T6 6t.288-.712T7 5h10q.425 0 .713.288T18 6v10q0 .425-.288.713T17 17t-.712-.288T16 16z"
                  ></path>
                </svg>

                {/* 头像 */}
                <div class="img-skeleton relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                  <img
                    src={item.imgurl}
                    alt=""
                    class="w-full h-full object-cover"
                    loading="lazy"
                    data-fallback={avatarFallbackChain}
                  />
                </div>

                {/* 内容 - 三行：站名 / 描述 / 标签 */}
                <div class="grow min-w-0 flex flex-col justify-center gap-0.5">
                  <div
                    data-title
                    class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate pr-16"
                  >
                    {item.title}
                  </div>

                  <div
                    data-desc
                    class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-1"
                    title={item.desc}
                  >
                    {item.desc}
                  </div>

                  {/* 标签 */}
                  <div class="flex flex-wrap gap-1 mt-1">
                    {item.tags && item.tags.length > 0
                      ? item.tags.slice(0, 3).map((tag) => (
                          <span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors duration-300">
                            {tag}
                          </span>
                        ))
                      : null}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
        <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}

  <!--
    友链详情弹窗：点卡片打开，SSR 与客户端重渲染共用这一份 DOM（内容由脚本按卡片属性填充）。
    脚本会把本节点移到 <body> 下 —— #content-wrapper 的 onload-animation 动画带 forwards
    填充，transform 会一直留着并成为 fixed 的包含块，留在原地弹窗就铺不满视口。
  -->
  <div id="friend-modal" class="friend-modal" hidden>
    <div class="friend-modal__backdrop" data-m-close></div>
    <div
      class="friend-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="friend-modal-title"
    >
      <button type="button" class="friend-modal__close" data-m-close aria-label="关闭">
        <Icon is:inline name="material-symbols:close-rounded" class="text-xl" />
      </button>

      {/* 站点截图：object-fit: contain，完整显示不裁切 */}
      <div class="friend-modal__shot js-detail-shot img-skeleton img-skeleton--js">
        <img data-m-img alt="" loading="eager" decoding="async" />
      </div>

      <div class="friend-modal__body">
        <div class="flex items-start gap-3">
          <div class="js-detail-avatar img-skeleton img-skeleton--js relative w-11 h-11 shrink-0 rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5">
            <img data-m-avatar alt="" loading="lazy" />
          </div>
          <div class="min-w-0 flex-1">
            <div
              id="friend-modal-title"
              data-m-title
              class="text-base font-bold text-neutral-900 dark:text-neutral-100 truncate"
            >
            </div>
            <div
              data-m-host
              class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400 truncate"
            >
            </div>
          </div>
          <div class="friend-latency shrink-0 flex items-center gap-1.5 px-2 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-xs font-medium">
            <span class="friend-latency-dot w-1.5 h-1.5 rounded-full"></span>
            <span class="friend-latency-text"></span>
          </div>
        </div>

        <p
          data-m-desc
          class="mt-3 text-sm text-neutral-600 dark:text-neutral-300 leading-6"
        >
        </p>

        <div data-m-tags class="mt-3 flex flex-wrap gap-1.5"></div>

        <div class="mt-4 flex flex-wrap gap-2">
          <a
            data-m-visit
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-regular rounded-lg px-3.5 py-2 text-sm font-medium gap-1.5"
          >
            <Icon is:inline name="material-symbols:arrow-outward-rounded" class="text-base" />
            访问站点
          </a>
          <a
            data-m-raw
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-regular rounded-lg px-3.5 py-2 text-sm font-medium gap-1.5"
          >
            <Icon is:inline name="material-symbols:image-search-rounded" class="text-base" />
            查看原图
          </a>
        </div>
      </div>
    </div>
  </div>

  <!--
    桌面端悬停预览：鼠标停在卡片上时在卡片上/下方浮出站点截图（只有图，卡片本身已经有
    站名/描述/标签了）。只读（pointer-events: none）——鼠标"穿过"它落到下面卡片上，
    所以不需要 hover 桥接。同样由脚本移到 <body> 下。
  -->
  <div id="friend-peek" class="friend-peek" hidden aria-hidden="true">
    <div class="friend-peek__shot js-detail-shot img-skeleton img-skeleton--js">
      <img data-m-img alt="" loading="eager" decoding="async" />
    </div>
  </div>

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const target = e.target;
          const button = target.closest("button");
          if (!button) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button");

          filters.forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (cardEl.querySelector("[data-title]")?.textContent || "").toLowerCase();
            const desc = (cardEl.querySelector("[data-desc]")?.textContent || "").toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }
  </script>

  <style is:global>
    /* 站点详情弹窗：点卡片打开（脚本会把 #friend-modal 移到 <body> 下） */
    .friend-modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .friend-modal[hidden] {
