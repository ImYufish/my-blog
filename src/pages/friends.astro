      }
      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }
      // 同域反代：与 SSR 端保持一致（fromHost → toHost），IMG_PROXY.enabled=false 时直接用原图
      function proxyImg(raw) {
        if (!raw || !IMG_PROXY.enabled || !IMG_PROXY.fromHost || !IMG_PROXY.toHost) return raw;
        try {
          var p = new URL(raw);
          if (p.hostname === IMG_PROXY.fromHost) {
            p.hostname = IMG_PROXY.toHost;
            return p.toString();
          }
        } catch (e) {}
        return raw;
      }
      // 构建 | 分隔的多级兜底链（与 SSR 端 buildFallbackChain 一致）：primary 是主图，
      // candidates 依次回退；自动去重并剔除主图本身。
      function buildFb(primary, candidates) {
        var seen = {};
        if (primary) seen[primary] = 1;
        var out = [];
        (candidates || []).forEach(function (c) {
          if (!c || seen[c]) return;
          seen[c] = 1;
          out.push(c);
        });
        return out.join("|");
      }
      // 外链箭头图标（内联路径，和 SSR 卡片里那份保持一致）
      // 不用 <Icon>：卡片由本函数整块重渲染，走图标组件的话 svg 只存在于 SSR，刷新后就没了
      var ARROW_SVG =
        '<svg class="absolute bottom-2 right-2 w-5 h-5 text-(--primary) opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" aria-hidden="true">' +
        '<path fill="currentColor" d="m16 8.4l-8.9 8.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7L14.6 7H7q-.425 0-.712-.288T6 6t.288-.712T7 5h10q.425 0 .713.288T18 6v10q0 .425-.288.713T17 17t-.712-.288T16 16z"></path></svg>';
      function cardHtml(f, rm) {
        const status = rm.get(normUrl(f.siteurl)) || null;
        const coverRaw = status && status.siteshot ? status.siteshot : f.imgurl;
        const cover = proxyImg(coverRaw);
        // 封面兜底链：封面失败 → 友链头像(imgurl) → 兜底头像(配置)
        const coverFb = buildFb(cover, [coverRaw, f.imgurl, DEFAULT_AVATAR]);
        // 头像兜底链：头像失败 → 兜底头像(配置)
        const avatarFb = buildFb(f.imgurl, [DEFAULT_AVATAR]);
        const dispLatency = status && status.latency_display != null && status.latency_display > 0 ? status.latency_display : (status && status.latency != null ? status.latency : null);
        const latencyMs = dispLatency != null && dispLatency > 0 ? Math.round(dispLatency * 1000) : null;
        const color = latencyColor(status && status.status, dispLatency != null && dispLatency > 0 ? dispLatency : null);
        const tags = (f.tags || []).slice(0, 3).map(function (t) {
          return '<span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors duration-300">' + esc(t) + "</span>";
        }).join("");
        const desc = f.desc
          ? '<div data-desc class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-1" title="' + esc(f.desc) + '">' + esc(f.desc) + "</div>"
          : "";
        const tagBox = f.tags && f.tags.length > 0
          ? '<div class="flex flex-wrap gap-1 mt-1">' + tags + "</div>"
          : "";
        return (
          '<a href="' + esc(f.siteurl) + '" target="_blank" rel="noopener noreferrer"' +
            ' data-tags="' + esc((f.tags || []).join(",")) + '"' +
            ' data-m-url="' + esc(f.siteurl) + '"' +
            ' data-m-shot="' + esc(cover) + '"' +
            ' data-m-shot-fb="' + esc(coverFb) + '"' +
            ' class="friend-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden">' +
            '<div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none"></div>' +
            ARROW_SVG +
            '<div class="friend-latency absolute top-2 right-2 z-10 flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-[0.65rem] font-medium">' +
              '<span class="friend-latency-dot w-1.5 h-1.5 rounded-full" style="background:' + color + '"></span>' +
              '<span class="friend-latency-text" style="color:' + color + '">' + (latencyMs != null ? latencyMs + " MS" : "OFFLINE") + "</span>" +
            "</div>" +
            '<div class="img-skeleton img-skeleton--js relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">' +
              '<img src="' + esc(f.imgurl) + '" alt="" class="w-full h-full object-cover" loading="lazy" data-fallback="' + esc(avatarFb) + '" />' +
            "</div>" +
            '<div class="grow min-w-0 flex flex-col justify-center gap-0.5">' +
              '<div data-title class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate pr-16">' + esc(f.title) + "</div>" +
              desc +
              tagBox +
            "</div>" +
          "</a>"
        );
      }
		async function refreshFriends() {
			if (!USE_REMOTE) {
				console.log("[friends] 已配置仅用本地友链，跳过远程刷新");
				return;
			}
			try {
          const [fr, rr] = await Promise.all([
            fetch(FRIENDS_URL, { cache: "no-store" }),
            fetch(RESULT_URL, { cache: "no-store" }).catch(function () { return null; }),
          ]);
          if (!fr.ok) return;
          const fd = await fr.json();
          const list = (fd.friends || [])
            .filter(function (f) { return f.enabled !== false; })
            .sort(function (a, b) { return (b.weight || 0) - (a.weight || 0); });
          const rm = new Map();
          if (rr && rr.ok) {
            const rd = await rr.json();
            // FCL link.json 结构：{ statistical_data, link_data: [...] }，映射为客户端渲染所需字段
            (rd.link_data || []).forEach(function (s) {
              const k = normUrl(s.link);
              if (!k) return;
              rm.set(k, {
                siteshot: s.siteshot || "",
                latency: s.latency != null ? s.latency : -1,
                latency_display: s.latency_display != null ? s.latency_display : -1,
                status: s.reachable ? "ok" : "fail",
              });
            });
          }
          const grid = document.querySelector(".friends-grid");
          if (!grid) return;
          if (list.length === 0) {
            grid.innerHTML = '<div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500"><div class="text-sm">暂无友链</div></div>';
          } else {
            grid.innerHTML = list.map(function (f) { return cardHtml(f, rm); }).join("");
          }
          // 重新套用当前筛选 / 搜索
          const active = document.querySelector("friend-filter button[data-active]");
          if (active) active.click();
        } catch (e) {
          console.warn("[friends] 客户端实时刷新失败，沿用构建时数据:", e);
        }
      }
      // 截图预取：进页面后空闲时按顺序把站点截图拉进浏览器缓存。
      // 之前只在 hover/点开那一下才 new Image()，第一次看必然干等下载 → 悬停一顿。
      // 源图是 webp、单张 11~78KB、25 张合计约 2MB，且 Cache-Control 一天，代价可接受；
      // 省流模式或 2G 网络下跳过，切到后台时暂停。
      function prefetchShots() {
        if (window.__friendShotPrefetched) return;
        var conn =
          navigator.connection || navigator.mozConnection || navigator.webkitConnection || {};
        if (conn.saveData) return;
        if (conn.effectiveType === "slow-2g" || conn.effectiveType === "2g") return;
        var queue = [];
        Array.prototype.forEach.call(
          document.querySelectorAll(".friend-card"),
          function (card) {
            var src = card.getAttribute("data-m-shot");
            if (src) queue.push(src);
          },
        );
        if (!queue.length) return;
        window.__friendShotPrefetched = true;

        var MAX_PARALLEL = 2;
        var active = 0;
        var idx = 0;
        function pump() {
          if (idx >= queue.length && active === 0) return;
          if (document.hidden) {
            setTimeout(pump, 1500);
            return;
          }
          while (active < MAX_PARALLEL && idx < queue.length) {
            var img = new Image();
            img.decoding = "async";
            active++;
            img.onload = img.onerror = function () {
              active--;
              pump();
            };
            img.src = queue[idx++];
          }
        }
        pump();
      }
      // 等友链渲染完再预取：refreshFriends 会整块重渲染 grid；再让首屏资源先抢一会儿带宽
      function scheduleShotPrefetch() {
        setTimeout(prefetchShots, 800);
      }
      if (document.readyState !== "loading") refreshFriends().then(scheduleShotPrefetch);
      else
        document.addEventListener("DOMContentLoaded", function () {
          refreshFriends().then(scheduleShotPrefetch);
        });
    })();
  </script>
</MainGridLayout>
