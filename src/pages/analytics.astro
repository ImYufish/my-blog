					return;
				}

				const tick = (timestamp) => {
					const progress = Math.min(1, Math.max(0, (timestamp - startedAt) / animationClock.duration));
					const generationProgress = easeCountProgress(Math.min(1, progress / generationEnd));
					cells.forEach((cell, index) => {
						const reveal = Math.max(0, Math.min(1, generationProgress * (cells.length + 1) - index));
						setCellReveal(cell, reveal);
					});

					const rhythmProgress = easeCountProgress(Math.max(0, Math.min(1, (progress - generationEnd) / (rhythmEnd - generationEnd))));
					const rhythmIndex = activeCells.length && progress >= generationEnd
						? Math.min(activeCells.length - 1, Math.floor(rhythmProgress * activeCells.length))
						: -1;
					activeCells.forEach((cell, index) => {
						const isCurrent = index === rhythmIndex && progress < rhythmEnd;
						cell.dataset.pushRhythmState = index <= rhythmIndex ? "lit" : "pending";
						cell.classList.toggle("is-push-rhythm-active", isCurrent);
						if (isCurrent) {
							const cellStart = rhythmIndex / activeCells.length;
							const localProgress = Math.max(0, Math.min(1, (rhythmProgress - cellStart) * activeCells.length));
							const pulse = localProgress <= 0.5 ? localProgress * 2 : 2 - localProgress * 2;
							cell.style.setProperty("--push-rhythm-pulse", pulse.toFixed(3));
						} else {
