		const sourcePolarPoint = (radius, angle) => {
			const radians = ((angle - 90) * Math.PI) / 180;
			return [50 + radius * Math.cos(radians), 50 + radius * Math.sin(radians)];
		};
		const describeSourceDonutSlice = (startAngle, endAngle) => {
			const outerStart = sourcePolarPoint(46, startAngle);
			const outerEnd = sourcePolarPoint(46, endAngle);
			const innerStart = sourcePolarPoint(25, startAngle);
			const innerEnd = sourcePolarPoint(25, endAngle);
			const largeArc = endAngle - startAngle > 180 ? 1 : 0;
			return [
				`M ${outerStart[0].toFixed(3)} ${outerStart[1].toFixed(3)}`,
				`A 46 46 0 ${largeArc} 1 ${outerEnd[0].toFixed(3)} ${outerEnd[1].toFixed(3)}`,
				`L ${innerEnd[0].toFixed(3)} ${innerEnd[1].toFixed(3)}`,
				`A 25 25 0 ${largeArc} 0 ${innerStart[0].toFixed(3)} ${innerStart[1].toFixed(3)}`,
				"Z",
			].join(" ");
		};
		const sourceAnimationFrames = new WeakMap();
		const sourceOverlayTimers = new WeakMap();
		const setTrafficSourceActive = (card, index) => {
			const svg = card.querySelector("[data-source-donut] svg");
			const overlay = svg?.querySelector("[data-source-active-overlay]");
			const activeKey = index === null ? "" : String(index);
			const previousTimer = sourceOverlayTimers.get(card);
			if (previousTimer) clearTimeout(previousTimer);
			card.dataset.sourceActiveIndex = activeKey;
			const activeSegment = index === null
				? null
				: [...card.querySelectorAll("[data-source-segment-index]")]
					.find((segment) => Number(segment.dataset.sourceSegmentIndex) === index);
			card.querySelectorAll("[data-source-segment-index]").forEach((segment) => {
				segment.dataset.active = "false";
			});
			card.querySelectorAll("[data-source-legend-index]").forEach((item) => {
				item.dataset.active = activeKey && item.dataset.sourceLegendIndex === activeKey ? "true" : "false";
			});
			if (!overlay || !activeSegment) {
				if (overlay) overlay.dataset.active = "false";
				return;
			}
			const activateOverlay = () => {
				if (card.dataset.sourceActiveIndex !== activeKey) return;
				overlay.setAttribute("d", activeSegment.getAttribute("d") || "");
				overlay.style.fill = activeSegment.style.fill;
				card.dataset.sourceRenderedIndex = activeKey;
				requestAnimationFrame(() => requestAnimationFrame(() => {
					if (card.dataset.sourceActiveIndex === activeKey) overlay.dataset.active = "true";
				}));
			};
			const previousRenderedKey = card.dataset.sourceRenderedIndex || "";
			if (previousRenderedKey && previousRenderedKey !== activeKey) {
				overlay.dataset.active = "false";
				const timer = window.setTimeout(() => {
					sourceOverlayTimers.delete(card);
					activateOverlay();
