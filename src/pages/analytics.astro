					});
					heatmapGrid.dataset.pushAnimationPhase = "complete";
					snake.setRevealProgress(1);
					snake.start();
					pushAnimationFrame = 0;
				};

				heatmapGrid.dataset.pushAnimationPhase = reducedMotion ? "complete" : "generating";
				cells.forEach((cell) => {
					cell.dataset.pushRhythmState = cell.dataset.pushActive === "true" ? "pending" : "idle";
					cell.style.setProperty("--push-cell-base-opacity", cell.dataset.level === "future" ? "0.22" : "1");
					cell.style.removeProperty("--push-rhythm-pulse");
					cell.classList.remove("is-push-rhythm-active");
					setCellReveal(cell, reducedMotion ? 1 : 0);
				});
				snake.setRevealProgress(reducedMotion ? 1 : 0);
				if (reducedMotion) {
