---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import Layout from "@/layouts/Layout.astro";
import MusicVisualizer from "@components/features/MusicVisualizer.astro";

const title = i18n(I18nKey.music);
const description =
	"";
---

<Layout title={`${title} - 3D可视化`} description={description}>
	<main class="music-visualizer-swup">
		<h1 class="sr-only">{title}</h1>
		<div class="music-visualizer-page">
			<MusicVisualizer />
		</div>
	</main>
</Layout>
